{
  "rewrites": [
    { "source": "/report/:token", "destination": "/api/report-og?token=:token" },
    { "source": "/blog/:slug", "destination": "/api/blog-og?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/oauth-result",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "unsafe-none" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "unsafe-none" }
      ]
    }
  ]
}
