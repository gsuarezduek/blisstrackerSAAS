{
  "actorSpecification": 1,
  "name": "linkedin-company-scraper",
  "title": "LinkedIn Company Page Scraper",
  "description": "Scrapea Company Pages públicas de LinkedIn (sin login). Devuelve followers, metadata y posts recientes con likes/comments/reposts.",
  "version": "1.2",
  "buildTag": "latest",
  "dockerfile": "../Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "LinkedIn Companies",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": ["name", "vanityName", "followerCount", "industry", "companySize", "headquarters", "postsCount"]
          },
          "display": {
            "component": "table",
            "properties": {
              "name":           { "label": "Empresa" },
              "vanityName":     { "label": "Slug" },
              "followerCount":  { "label": "Seguidores", "format": "number" },
              "industry":       { "label": "Industria" },
              "companySize":    { "label": "Tamaño" },
              "headquarters":   { "label": "HQ" },
              "postsCount":     { "label": "Posts recientes", "format": "number" }
            }
          }
        }
      }
    }
  }
}
