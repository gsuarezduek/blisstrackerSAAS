// ─── ANUNCIOS ─────────────────────────────────────────────────────────────────

model Announcement {
  id                 Int       @id @default(autoincrement())
  title              String
  body               String
  type               String    @default("info") // "info" | "warning" | "maintenance" | "feature"
  targetAll          Boolean   @default(true)
  targetWorkspaceIds String    @default("[]") // JSON: [1, 2, 3] — usado cuando targetAll = false
  active             Boolean   @default(false)
  startsAt           DateTime?
  endsAt             DateTime?
  createdById        Int
  createdBy          User      @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([active])
}

// ─── MARKETING / GEO ─────────────────────────────────────────────────────────

model GeoAudit {
  id              Int      @id @default(autoincrement())
  workspaceId     Int
  projectId       Int
  url             String
  status          String   @default("pending") // pending | running | completed | failed
  score           Int?
  citability      Int?
  brandAuthority  Int?
  eeat            Int?
  technical       Int?
  schema          Int?
  platforms       Int?
  findings        String   @default("[]") // JSON: [{severity, component, title, description}]
  recommendations String   @default("[]") // JSON: [{priority, action, impact}]
  rawData         String?
  errorMsg        String?
  tokensUsed      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
}

// ─── FEATURE FLAGS ───────────────────────────────────────────────────────────

model FeatureFlag {
  id                  Int      @id @default(autoincrement())
  key                 String   @unique // ej: "vacation_requests"
  name                String // nombre legible, ej: "Solicitud de vacaciones"
  description         String   @default("")
  enabledGlobally     Boolean  @default(false)
  enabledWorkspaceIds String   @default("[]") // JSON: [1, 2] — workspaces con acceso cuando !enabledGlobally
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([key])
}

// ─── INTEGRACIONES EXTERNAS ──────────────────────────────────────────────────

model ProjectIntegration {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  type        String // "google_analytics" | "google_ads" | "instagram" | "tiktok" | "meta_ads" | "linkedin"
  status      String @default("active") // "active" | "expired" (se marca al detectar invalid_grant / token vencido)

  propertyId String? // GA4: "properties/123456789"
  customerId String? // Google Ads: "123-456-7890"
  country    String  @default("arg") // ISO 3166-1 alpha-3 lowercase (arg, mex, esp…) — país de referencia para keywords

  // Tokens cifrados (AES-256-GCM, formato "iv:tag:ciphertext" hex)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scopes       String    @default("")

  // Identidad de la cuenta de Google que autorizó (sub del id_token; email como apoyo).
  // Permite scopear la propagación de tokens POR CUENTA: con 2 cuentas de Google
  // distintas en el mismo workspace, reconectar una NO pisa el token de la otra.
  accountId    String? // sub estable del id_token de Google
  accountEmail String? // email de la cuenta autorizada (informativo/UI)

  connectedById Int?
  connectedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([workspaceId])
  @@index([projectId])
  @@index([workspaceId, type, accountId])
}

// ─── AVATARES ─────────────────────────────────────────────────────────────────

model Avatar {
  id        Int      @id @default(autoincrement())
  filename  String   @unique
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  imageData Bytes
  mimeType  String   @default("image/png")
  createdAt DateTime @default(now())

  @@index([order])
  @@index([active])
}

// ─── DOCUMENTOS LEGALES ───────────────────────────────────────────────────────

model LegalDocument {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. "terms_of_service"
  title     String
  content   String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ─── ANALYTICS SNAPSHOTS ──────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  month       String // "2026-04" (YYYY-MM)

  sessions    Int    @default(0)
  activeUsers Int    @default(0)
  newUsers    Int    @default(0)
  pageviews   Int    @default(0)
  bounceRate  Float  @default(0)
  avgDuration Float  @default(0) // segundos
  conversions Int    @default(0)
  topChannels String @default("[]") // JSON: [{channel, sessions, users}]
  topPages    String @default("[]") // JSON: [{path, title, pageviews, sessions}]
  topSources  String @default("[]") // JSON: [{source, medium, sessions, pct}]
  aiTraffic   String @default("{}") // JSON: { chatgpt, claude, gemini, grok, metaAi, perplexity, copilot, other }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([workspaceId])
  @@index([projectId])
}

model AnalyticsInsight {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  month       String // "2026-04"

  // JSON: { titulo, resumen, tendencias: [{metrica, delta, positivo}], recomendaciones: [string] }
  content     String
  generatedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([workspaceId])
  @@index([projectId])
}

// ─── PAGESPEED RESULTS ────────────────────────────────────────────────────────

model PageSpeedResult {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  url         String
  strategy    String @default("mobile") // "mobile" | "desktop"
  status      String @default("running") // "running" | "done" | "error"

  performanceScore Int? // 0-100

  // JSON: { lcp, fcp, tbt, cls, si, ttfb } con { displayValue, numericValue, score, rating }
  metrics String @default("{}")

  // JSON: [{ id, title, description, savingsMs, score }]
  opportunities String @default("[]")

  // JSON: [{ id, title, description, score }]
  diagnostics String @default("[]")

  errorMsg  String?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
}

// ─── KEYWORD TRACKING ─────────────────────────────────────────────────────────

model TrackedKeyword {
  id                Int       @id @default(autoincrement())
  projectId         Int
  workspaceId       Int
  query             String
  analysisContent   String? // JSON output de Claude (cacheado)
  analysisUpdatedAt DateTime?
  createdAt         DateTime  @default(now())

  project             Project              @relation("ProjectTrackedKeywords", fields: [projectId], references: [id], onDelete: Cascade)
  workspace           Workspace            @relation("WorkspaceTrackedKeywords", fields: [workspaceId], references: [id], onDelete: Cascade)
  rankings            KeywordRanking[]
  serpSnapshots       SerpSnapshot[]
  marketingObjectives MarketingObjective[]

  @@unique([projectId, query])
  @@index([projectId, workspaceId])
}

model KeywordRanking {
  id               Int      @id @default(autoincrement())
  trackedKeywordId Int
  projectId        Int
  workspaceId      Int
  month            String // "2026-04"
  clicks           Int      @default(0)
  impressions      Int      @default(0)
  ctr              Float    @default(0)
  position         Float    @default(0)
  createdAt        DateTime @default(now())

  trackedKeyword TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  project        Project        @relation("ProjectKeywordRankings", fields: [projectId], references: [id], onDelete: Cascade)
  workspace      Workspace      @relation("WorkspaceKeywordRankings", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([trackedKeywordId, month])
  @@index([projectId, workspaceId])
}

// ─── SERP SNAPSHOTS ───────────────────────────────────────────────────────────

model SerpSnapshot {
  id               Int      @id @default(autoincrement())
  trackedKeywordId Int
  projectId        Int
  workspaceId      Int
  capturedAt       DateTime @default(now())

  position  Int? // null = no aparece en top 100
  resultUrl String? // URL exacta que rankea

  // JSON serializado (arrays)
  serpFeatures    String @default("[]") // ["featured_snippet", "ai_overview", ...]
  competitors     String @default("[]") // [{ position, domain, url, title }]
  peopleAlsoAsk   String @default("[]") // [string]
  relatedSearches String @default("[]") // [string]

  country      String  @default("ar") // código SerpAPI (gl)
  totalResults String?

  trackedKeyword TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)

  @@index([trackedKeywordId, capturedAt])
  @@index([projectId, workspaceId])
}

// ─── INSTAGRAM SNAPSHOTS ──────────────────────────────────────────────────────

model InstagramSnapshot {
  id             Int      @id @default(autoincrement())
  projectId      Int
  workspaceId    Int
  month          String // "YYYY-MM"
  followersCount Int      @default(0)
  mediaCount     Int?
  avgLikes       Float?
  avgComments    Float?
  engagementRate Float?
  postsCount     Int? // publicaciones nuevas en ese mes
  reach          Int? // alcance único de la cuenta en el mes (Insights)
  views          Int? // vistas/impresiones de la cuenta en el mes (Insights)
  totalSaved     Int? // guardados sumados de las publicaciones del mes (Insights)
  totalShares    Int? // compartidos sumados de las publicaciones del mes (Insights)
  avgReach       Float? // alcance promedio por publicación del mes (Insights)
  topPosts       String   @default("[]") // JSON: [{ id, likeCount, commentsCount, reach, saved, shares, views, imgSrc, permalink, mediaType, caption, timestamp }]
  createdAt      DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([workspaceId])
}

// ─── SOCIAL IMAGE (cache de imágenes de RRSS) ─────────────────────────────────
// Las URLs de imágenes de los CDN de Instagram/Facebook/TikTok vienen firmadas y
// vencen (horas/días). Para que los top posts de snapshots e informes no queden
// con la imagen rota ("URL signature expired"), al capturar un snapshot
// descargamos los bytes mientras la URL es válida y los servimos desde acá.
model SocialImage {
  id          String   @id @default(uuid())
  workspaceId Int
  sourceUrl   String   @db.Text // URL original del CDN (referencia/dedup)
  imageData   Bytes? // bytes en DB (legacy / fallback si no hay object storage configurado)
  objectKey   String? // key del objeto en Cloudflare R2 cuando vive en object storage; null = vive en imageData
  sizeBytes   Int? // tamaño del blob, para reportar peso esté en DB o en R2
  mimeType    String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── INSTAGRAM FOLLOWER LOG ───────────────────────────────────────────────────

model InstagramFollowerLog {
  id             Int      @id @default(autoincrement())
  projectId      Int
  workspaceId    Int
  date           String // "YYYY-MM-DD" en horario ART
  followersCount Int
  createdAt      DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([workspaceId])
}

// Historias (stories) de Instagram — efímeras (24h). Se capturan a diario por un cron
// (varias veces al día para refinar los insights, que crecen mientras la story está viva)
// y se persisten acá para poder agregarlas por mes. Requiere API oficial con el permiso
// instagram_business_manage_insights; por scraping las stories no son accesibles.
model InstagramStory {
  id          Int      @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  storyId     String // media id de IG (dedup + upsert de insights)
  month       String // "YYYY-MM" en horario ART (para agregación mensual)
  publishedAt DateTime
  mediaType   String? // IMAGE | VIDEO
  imgSrc      String? // thumbnail cacheado (la URL del CDN de IG vence)
  permalink   String?
  // Insights (best-effort; null si el permiso no está o la API no los devolvió)
  reach       Int?
  replies     Int?
  views       Int? // vistas/impresiones
  tapsForward Int?
  tapsBack    Int?
  exits       Int?
  insightsRaw String? // JSON crudo de insights, por si Meta cambia las métricas
  capturedAt  DateTime @updatedAt // última captura (los insights se refrescan durante las 24h)
  createdAt   DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, storyId])
  @@index([workspaceId])
  @@index([projectId, month])
}

// Competidores de RRSS — cuentas de la competencia que se trackean por scraping.
// Por ahora solo Instagram (platform = "instagram").
model CompetitorAccount {
  id            Int      @id @default(autoincrement())
  projectId     Int
  workspaceId   Int
  platform      String   @default("instagram")
  username      String // handle sin @
  displayName   String?
  profilePicUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots           CompetitorSnapshot[]
  followerLogs        CompetitorFollowerLog[]
  marketingObjectives MarketingObjective[]

  @@unique([projectId, platform, username])
  @@index([workspaceId])
  @@index([projectId])
}

model CompetitorSnapshot {
  id             Int      @id @default(autoincrement())
  competitorId   Int
  workspaceId    Int
  month          String // "YYYY-MM"
  followersCount Int      @default(0)
  mediaCount     Int?
  postsCount     Int? // publicaciones nuevas en ese mes
  avgLikes       Float?
  avgComments    Float?
  engagementRate Float?
  topPosts       String   @default("[]") // JSON con top publicaciones
  createdAt      DateTime @default(now())

  competitor CompetitorAccount @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, month])
  @@index([workspaceId])
  @@index([competitorId])
}

model CompetitorFollowerLog {
  id             Int      @id @default(autoincrement())
  competitorId   Int
  workspaceId    Int
  date           String // "YYYY-MM-DD" en horario ART
  followersCount Int
  createdAt      DateTime @default(now())

  competitor CompetitorAccount @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, date])
  @@index([workspaceId])
  @@index([competitorId])
}

// ─── TIKTOK SNAPSHOTS ─────────────────────────────────────────────────────────

model TikTokSnapshot {
  id             Int      @id @default(autoincrement())
  projectId      Int
  workspaceId    Int
  month          String // "YYYY-MM"
  followersCount Int      @default(0)
  videoCount     Int?
  likesCount     Float? // total likes acumulados de la cuenta
  avgViews       Float?
  avgLikes       Float?
  avgComments    Float?
  avgShares      Float?
  postsThisMonth Int?
  engagementRate Float?
  topVideos      String   @default("[]") // JSON: [{ id, title, coverUrl, shareUrl, viewCount, likeCount, commentCount, shareCount, duration, createTime }]
  createdAt      DateTime @default(now())

