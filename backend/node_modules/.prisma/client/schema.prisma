generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── WORKSPACE ───────────────────────────────────────────────────────────────

model Workspace {
  id                        Int       @id @default(autoincrement())
  name                      String
  slug                      String    @unique // subdominio, ej: "bliss"
  timezone                  String    @default("America/Argentina/Buenos_Aires")
  status                    String    @default("trialing") // trialing | active | past_due | suspended | cancelled
  trialEndsAt               DateTime?
  stripeCustomerId          String?
  // Branding / perfil de empresa
  companyName               String?
  companyDescription        String?
  industry                  String?
  companyWebsite            String?
  logoData                  Bytes?
  logoMimeType              String?
  bannerData                Bytes?
  bannerMimeType            String?
  // Feature flags: keys que este workspace optó por desactivar (aunque estén habilitados globalmente o en su lista)
  disabledFeatureKeys       String    @default("[]")
  monthlyTokenLimit         Int       @default(1000000) // Límite mensual de tokens de IA (configurable desde SuperAdmin)
  attendanceTrackingEnabled Boolean   @default(true) // Seguimiento de horarios y puntualidad en RRHH. OFF = oculta puntualidad/tardanzas (ej: equipos full freelance sin horarios)
  productivityEnabled       Boolean   @default(true) // Muestra la sección de Productividad (nav + página) para los admins
  productivityDigestEnabled Boolean   @default(true) // Aviso semanal por mail a admins/owners con las personas en alerta de Productividad
  lateToleranceMins         Int       @default(0) // Tolerancia (min) para tardanza: la llegada cuenta tarde solo si supera workStartTime + tolerancia
  lateNotifyEnabled         Boolean   @default(false) // Enviar email a quien acumula tardanzas en los últimos 30 días
  lateNotifyThreshold       Int       @default(3) // Cantidad de tardanzas (1-10) en 30 días que dispara el email
  lateNotifyTemplate        String? // Cuerpo del email de tardanza (placeholders [Nombre] y [workspace]); null = texto por defecto
  legajoEnabled             Boolean   @default(true) // Muestra la tarjeta/hint de legajos en RRHH. OFF = no se nudge-ea completar el legajo
  legajoFields              Json      @default("[]") // Config del formulario de legajo (campos default + custom). [] = usa el catálogo default
  billingExempt             Boolean   @default(false) // Exento de billing (ej: workspace bliss). Nunca pasa a past_due por superar el free tier.
  demoSeeded                Boolean   @default(false) // True si tiene proyecto "Demo — Aprendé BlissTracker"
  // Identidad de marca
  brandColors               String    @default("[]") // JSON: [{ hex, name? }]
  brandFonts                String    @default("[]") // JSON: [{ name, role }] role: heading|body|accent
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  members                    WorkspaceMember[]
  projects                   Project[]
  userRoles                  UserRole[]
  services                   Service[]
  roleExpectations           RoleExpectation[]
  aiTokenLogs                AiTokenLog[]
  dailyInsights              DailyInsight[]
  insightMemories            UserInsightMemory[]
  notesBoardNotes            NotesBoardNote[]
  notifications              Notification[]
  workDays                   WorkDay[]
  taskRecurrences            TaskRecurrence[]
  subscription               Subscription?
  loginEvents                UserLogin[]
  feedbacks                  Feedback[]
  invitations                WorkspaceInvitation[]
  deletionRequest            WorkspaceDeletionRequest?
  emailLogs                  EmailLog[]
  vacationAdjustments        VacationAdjustment[]
  vacationRequests           VacationRequest[]
  geoAudits                  GeoAudit[]
  integrations               ProjectIntegration[]
  analyticsSnapshots         AnalyticsSnapshot[]
  analyticsInsights          AnalyticsInsight[]
  pageSpeedResults           PageSpeedResult[]
  trackedKeywords            TrackedKeyword[]            @relation("WorkspaceTrackedKeywords")
  keywordRankings            KeywordRanking[]            @relation("WorkspaceKeywordRankings")
  instagramSnapshots         InstagramSnapshot[]
  instagramFollowerLogs      InstagramFollowerLog[]
  instagramStories           InstagramStory[]
  tiktokSnapshots            TikTokSnapshot[]
  tiktokFollowerLogs         TikTokFollowerLog[]
  youtubeSnapshots           YouTubeSnapshot[]
  youtubeFollowerLogs        YouTubeFollowerLog[]
  linkedinSnapshots          LinkedinSnapshot[]
  linkedinFollowerLogs       LinkedinFollowerLog[]
  facebookSnapshots          FacebookSnapshot[]
  facebookFollowerLogs       FacebookFollowerLog[]
  monthlyReports             MonthlyReport[]
  reportFeedback             ReportFeedback[]
  searchConsoleSnapshots     SearchConsoleSnapshot[]
  seoAiInsights              SeoAiInsight[]
  cannibalReports            CannibalReport[]
  adsSnapshots               AdsSnapshot[]
  socialImages               SocialImage[]
  eosData                    EOSData?
  peopleAnalyzerRatings      PeopleAnalyzerRating[]
  eosStrikes                 EOSStrike[]
  accountabilityNodes        AccountabilityNode[]
  scorecardMetrics           ScorecardMetric[]
  scorecardEntries           ScorecardEntry[]
  eosProcesses               EOSProcess[]
  eosProcessSteps            EOSProcessStep[]
  eosIssues                  EOSIssue[]
  eosRocks                   EOSRock[]
  eosTodos                   EOSTodo[]
  eosMeetings                EOSMeeting[]
  projectMeetings            ProjectMeeting[]
  projectMeetingTodos        ProjectMeetingTodo[]
  projectMeetingParticipants ProjectMeetingParticipant[]
  orgAssessmentRounds        OrgAssessmentRound[]
  orgAssessmentResponses     OrgAssessmentResponse[]
  marketingObjectives        MarketingObjective[]
  projectBriefs              ProjectBrief[]
  rrhhMetricSnapshots        RrhhMetricSnapshot[]
  projectAccesses            ProjectAccess[]
  projectAccessLogs          ProjectAccessLog[]
  games                      Game[]
  taskFollows                TaskFollow[]

  @@index([slug])
}

model WorkspaceMember {
  workspaceId Int
  userId      Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  role         String  @default("member") // "owner" | "admin" | "member"
  teamRole     String  @default("") // ej: "DESIGNER", "CM" (referencia a UserRole.name)
  active       Boolean @default(true)
  vacationDays Int     @default(0)

  // Horario laboral (para cálculo de tardanzas vs hora de login). Formato "HH:MM" en la timezone del workspace. null = sin horario configurado.
  workStartTime String? // ej: "09:00"
  workEndTime   String? // ej: "18:00"

  // Preferencias IA (por workspace)
  weeklyEmailEnabled   Boolean @default(true)
  dailyInsightEnabled  Boolean @default(true)
  insightMemoryEnabled Boolean @default(true)
  taskQualityEnabled   Boolean @default(true)

  // Preferencias de UI (por workspace)
  notesBoardEnabled Boolean @default(true) // mostrar/ocultar la pizarra de notas

  // Respuestas de los campos custom del legajo (los campos default viven en columnas de User).
  // Workspace-scoped: { fieldKey: value }. Ver Workspace.legajoFields.
  legajoData Json @default("{}")

  joinedAt DateTime @default(now())

  @@id([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Subscription {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  stripeSubId String?   @unique
  planName    String    @default("pro")
  status      String // active | past_due | cancelled | trialing
  seats       Int       @default(0)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── USER (global — datos personales, no workspace-specific) ─────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  // ID estable de la cuenta de Google vinculada (el `sub` del token de Google).
  // Permite iniciar sesión con Google aunque el email de esa cuenta difiera del
  // email primario, y sobrevive a un cambio de email. null = sin Google conectado.
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Super admin global (solo equipo Bliss)
  isSuperAdmin Boolean @default(false)

  // Datos personales (opcionales, globales al usuario)
  phone             String?
  birthday          DateTime?
  address           String?
  dni               String?
  cuit              String?
  alias             String?
  bankName          String?
  maritalStatus     String?
  children          Int?
  educationLevel    String?
  educationTitle    String?
  bloodType         String?
  medicalConditions String?
  healthInsurance   String?
  emergencyContact  String?
  avatar            String    @default("2bee.png")

  // Relaciones
  workspaceMembers          WorkspaceMember[]
  workDays                  WorkDay[]
  tasks                     Task[]
  tasksCreated              Task[]                      @relation("TaskCreatedBy")
  taskRecurrences           TaskRecurrence[]            @relation("RecurrenceAssignee")
  taskRecurrencesCreated    TaskRecurrence[]            @relation("RecurrenceCreatedBy")
  taskComments              TaskComment[]
  taskFollows               TaskFollow[]                @relation("TaskFollower")
  dailyInsights             DailyInsight[]
  insightMemories           UserInsightMemory[]
  notesBoardNotes           NotesBoardNote[]
  feedbacks                 Feedback[]
  projects                  ProjectMember[]
  starredProjects           ProjectStar[]
  notifications             Notification[]              @relation("NotificationRecipient")
  notificationsAsActor      Notification[]              @relation("NotificationActor")
  passwordResetTokens       PasswordResetToken[]
  emailChangeTokens         EmailChangeToken[]
  loginEvents               UserLogin[]
  sentInvitations           WorkspaceInvitation[]       @relation("InvitedByUser")
  deletionRequestsMade      WorkspaceDeletionRequest[]  @relation("DeletionRequestedBy")
  deletionRequestsCancelled WorkspaceDeletionRequest[]  @relation("DeletionCancelledBy")
  vacationAdjustments       VacationAdjustment[]        @relation("VacationAdjustmentUser")
  vacationAdjustmentsAdmin  VacationAdjustment[]        @relation("VacationAdjustmentAdmin")
  vacationRequests          VacationRequest[]           @relation("VacationRequestUser")
  vacationRequestsReviewed  VacationRequest[]           @relation("VacationRequestReviewer")
  announcements             Announcement[]              @relation("AnnouncementCreatedBy")
  analyzerRatings           PeopleAnalyzerRating[]      @relation("AnalyzedPerson")
  eosStrikesReceived        EOSStrike[]                 @relation("StrikedPerson")
  eosStrikesGiven           EOSStrike[]                 @relation("StrikeCreator")
  accountabilitySeats       AccountabilityNode[]        @relation("SeatHolder")
  ownedMetrics              ScorecardMetric[]           @relation("MetricOwner")
  ownedIssues               EOSIssue[]                  @relation("IssueOwner")
  createdIssues             EOSIssue[]                  @relation("IssueCreatedBy")
  ownedRocks                EOSRock[]                   @relation("RockOwner")
  ownedTodos                EOSTodo[]                   @relation("TodoOwner")
  ownedMeetingTodos         ProjectMeetingTodo[]        @relation("MeetingTodoOwner")
  meetingParticipations     ProjectMeetingParticipant[] @relation("MeetingParticipant")
  orgAssessmentResponses    OrgAssessmentResponse[]
  generatedReports          MonthlyReport[]             @relation("ReportGeneratedBy")
  platformSettingChanges    PlatformSettingLog[]        @relation("SettingChangedBy")
  accessRevealLogs          ProjectAccessLog[]
}

model UserLogin {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  loginAt     DateTime   @default(now())
  method      String // "email" | "google"

  @@index([userId])
  @@index([workspaceId])
  @@index([loginAt])
}

// Snapshot mensual de métricas del MiniDashboard de RRHH (evolución histórica).
// metric: "projectsPerPerson" (value = proyectos÷equipo) | "tenure" (value = antigüedad promedio en años).
// detail (JSON) guarda el contexto de cada métrica (ej: activeMembers/activeProjects, memberCount).
model RrhhMetricSnapshot {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String // "projectsPerPerson" | "tenure"
  month       String // "YYYY-MM" en la timezone del workspace
  value       Float     @default(0)
  detail      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, metric, month])
  @@index([workspaceId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Token de verificación para el cambio de email primario. Se confirma desde el
// link enviado al NUEVO correo; recién ahí se actualiza User.email.
model EmailChangeToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  newEmail  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Feedback {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  workspaceId Int?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id])
  type        FeedbackType
  message     String
  read        Boolean      @default(false)
  createdAt   DateTime     @default(now())
}

enum FeedbackType {
  SUGGESTION
  BUG
}

// ─── WORKSPACE-SCOPED: ROLES, PROYECTOS, SERVICIOS ───────────────────────────

model UserRole {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String // identificador interno, ej: "DESIGNER"
  label       String // nombre para mostrar, ej: "Diseñador"
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Project {
  id                  Int       @id @default(autoincrement())
  workspaceId         Int
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  name                String
  active              Boolean   @default(true)
  lostAt              DateTime? // se setea al pasar a inactivo (true→false), se limpia al reactivar; alimenta "Proyectos perdidos" del Scorecard EOS
  situation           String?
  timezone            String    @default("America/Argentina/Buenos_Aires")
  linksEnabled        Boolean   @default(true)
  situationEnabled    Boolean   @default(true)
  hoursEnabled        Boolean   @default(false)
  briefsEnabled       Boolean   @default(true)
  monthlyHours        Int?
  emailFrom           String?
  aiWeeklyTokenLimit  Int       @default(500000)
  websiteUrl          String?
  connections         String    @default("{}") // JSON: { instagram, facebook, ... }
  integrationDefaults String    @default("{}") // JSON: IDs recordados por tipo para reconexión, ej { google_ads: { customerId, propertyId, country }, google_analytics: { propertyId } }
  domainRating        Float? // Ahrefs Domain Rating (0-100), valor actual cacheado
  domainRatingAt      DateTime? // última actualización del Domain Rating
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tasks                  Task[]
  taskRecurrences        TaskRecurrence[]
  services               ProjectService[]
  members                ProjectMember[]
  stars                  ProjectStar[]
  notifications          Notification[]
  links                  ProjectLink[]
  geoAudits              GeoAudit[]
  integrations           ProjectIntegration[]
  analyticsSnapshots     AnalyticsSnapshot[]
  analyticsInsights      AnalyticsInsight[]
  pageSpeedResults       PageSpeedResult[]
  trackedKeywords        TrackedKeyword[]        @relation("ProjectTrackedKeywords")
  keywordRankings        KeywordRanking[]        @relation("ProjectKeywordRankings")
  instagramSnapshots     InstagramSnapshot[]
  instagramFollowerLogs  InstagramFollowerLog[]
  instagramStories       InstagramStory[]
  tiktokSnapshots        TikTokSnapshot[]
  tiktokFollowerLogs     TikTokFollowerLog[]
  youtubeSnapshots       YouTubeSnapshot[]
  youtubeFollowerLogs    YouTubeFollowerLog[]
  linkedinSnapshots      LinkedinSnapshot[]
  linkedinFollowerLogs   LinkedinFollowerLog[]
  facebookSnapshots      FacebookSnapshot[]
  facebookFollowerLogs   FacebookFollowerLog[]
  monthlyReports         MonthlyReport[]
  searchConsoleSnapshots SearchConsoleSnapshot[]
  seoAiInsights          SeoAiInsight[]
  cannibalReports        CannibalReport[]
  adsSnapshots           AdsSnapshot[]
  competitors            CompetitorAccount[]
  marketingObjectives    MarketingObjective[]
  briefs                 ProjectBrief[]
  accesses               ProjectAccess[]
  accessLogs             ProjectAccessLog[]
  meetings               ProjectMeeting[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Service {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects ProjectService[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ProjectService {
  projectId Int
  serviceId Int
  project   Project @relation(fields: [projectId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([projectId, serviceId])
}

model ProjectMember {
  projectId Int
  userId    Int
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

// Proyectos destacados por usuario (preferencia personal en "Mis Proyectos").
model ProjectStar {
  projectId Int
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectLink {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Accesos / credenciales por proyecto (Cuenta, Usuario, Contraseña, 2FA, Extra).
// La contraseña y el 2FA se guardan cifrados con AES-256-GCM (lib/encryption.js) y
// solo se descifran bajo demanda en el endpoint reveal. Todos los campos son opcionales.
model ProjectAccess {
  id          Int      @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  account     String? // Cuenta (ej. "Instagram")
  username    String? // Usuario
  password    String? // Contraseña cifrada ("iv:tag:ciphertext")
  twofa       String? // Segundo factor (2FA) cifrado ("iv:tag:ciphertext")
  extra       String? // Notas / dato extra
  createdAt   DateTime @default(now())

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revealLogs ProjectAccessLog[]

  @@index([projectId])
  @@index([workspaceId])
}

// Log de auditoría: registra quién solicitó ver un dato sensible (contraseña o 2FA)
// de un acceso. Por ahora solo se persiste el evento; la visualización del log se
// desarrollará más adelante. accessId queda en SetNull para conservar el historial
// aunque el acceso se elimine.
model ProjectAccessLog {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  accessId    Int?
  userId      Int
  field       String // "password" | "twofa" — qué dato se solicitó
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  access    ProjectAccess? @relation(fields: [accessId], references: [id], onDelete: SetNull)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([accessId])
  @@index([userId])
}

// ─── WORKDAY & TASKS ─────────────────────────────────────────────────────────

model WorkDay {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  date        String // "YYYY-MM-DD"
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  tasks Task[]

  @@unique([userId, workspaceId, date])
  @@index([userId, date])
  @@index([workspaceId, date])
  @@index([date])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
}

model Task {
  id                 Int             @id @default(autoincrement())
  workDayId          Int
  workDay            WorkDay         @relation(fields: [workDayId], references: [id])
  userId             Int
  user               User            @relation(fields: [userId], references: [id])
  createdById        Int?
  createdBy          User?           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  projectId          Int
  project            Project         @relation(fields: [projectId], references: [id])
  description        String
  status             TaskStatus      @default(PENDING)
  blockedReason      String?
  startedAt          DateTime?
  pausedAt           DateTime?
  pausedMinutes      Int             @default(0)
  completedAt        DateTime?
  minutesOverride    Int?
  starred            Int             @default(0)
  isBacklog          Boolean         @default(false)
  dismissedByCreator Boolean         @default(false)
  // Tareas futuras/recurrentes: fecha de aparición "YYYY-MM-DD". null = tarea normal/ya activa.
  // Mientras scheduledFor > hoy la tarea NO aparece en el foco/backlog; al llegar la fecha se
  // engancha al workday del día y se setea scheduledFor = null (activación perezosa + cron).
  scheduledFor       String?
  // Instancia generada por una recurrencia (null = tarea suelta). SetNull conserva el historial
  // completado si se borra la serie.
  recurrenceId       Int?
  recurrence         TaskRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  notifications      Notification[]
  comments           TaskComment[]
  sessions           TaskSession[]
  followers          TaskFollow[]
  eosTodo            EOSTodo? // To-Do de L10 vinculado (uno a uno); completar la tarea lo tilda
  meetingTodo        ProjectMeetingTodo? // To-Do de reunión de proyecto vinculado (uno a uno); completar la tarea lo tilda
  meetingParticipant ProjectMeetingParticipant? // Tarea auto-creada por una reunión de proyecto (uno a uno); su tiempo es la participación en la reunión

  @@index([userId, status])
  @@index([projectId])
  @@index([workDayId])
  @@index([userId, scheduledFor])
  @@index([recurrenceId])
}

// Plantilla de tarea recurrente. Genera instancias Task (con scheduledFor + recurrenceId) que
// se materializan de a una por adelantado (sin backfill de ocurrencias perdidas).
model TaskRecurrence {
  id              Int       @id @default(autoincrement())
  workspaceId     Int
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          Int // a quién se le asigna la tarea
  user            User      @relation("RecurrenceAssignee", fields: [userId], references: [id], onDelete: Cascade)
  createdById     Int? // quién la creó/delegó (null si es propia)
  createdBy       User?     @relation("RecurrenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String
  frequency       String // daily | weekly | monthly | annual
  weekdays        String    @default("[]") // JSON [0-6] (0=domingo) — solo weekly
  dayOfMonth      Int? // 1-31 — monthly/annual (derivado de startDate)
  month           Int? // 1-12 — annual (derivado de startDate)
  startDate       String // "YYYY-MM-DD" — primera ocurrencia
  endDate         String? // "YYYY-MM-DD" — null = nunca termina
  lastSpawnedDate String? // "YYYY-MM-DD" — última ocurrencia materializada (para generar la próxima sin backfill)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tasks Task[]

  @@index([workspaceId, active])
  @@index([userId, active])
}

model TaskSession {
  id        Int       @id @default(autoincrement())
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([taskId])
  @@index([startedAt])
}

model TaskComment {
  id        Int           @id @default(autoincrement())
  taskId    Int
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  content   String
  parentId  Int?
  parent    TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   TaskComment[] @relation("CommentReplies")
  createdAt DateTime      @default(now())

  @@index([taskId])
}

// Seguimiento de una tarea por un usuario que no es necesariamente su dueño ni quien la creó.
// Al completarse o comentarse una tarea seguida, el seguidor recibe la notificación
// (COMPLETED / TASK_COMMENT) además de los destinatarios habituales.
model TaskFollow {
  id          Int       @id @default(autoincrement())
  taskId      Int
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation("TaskFollower", fields: [userId], references: [id], onDelete: Cascade)
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([taskId, userId])
  @@index([userId, workspaceId])
  @@index([taskId])
}

// ─── NOTIFICACIONES ──────────────────────────────────────────────────────────

enum NotificationType {
  COMPLETED
  BLOCKED
  ADDED_TO_PROJECT
  TASK_COMMENT
  TASK_MENTION
  VACATION_REQUEST
  VACATION_REVIEWED
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id])
  actorId     Int
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id])
  workspaceId Int
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  taskId      Int?
  task        Task?            @relation(fields: [taskId], references: [id])
  projectId   Int?
  project     Project?         @relation(fields: [projectId], references: [id])
  type        NotificationType @default(COMPLETED)
  message     String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([workspaceId])
}

// ─── AI: INSIGHTS, MEMORY, TOKENS ────────────────────────────────────────────

model DailyInsight {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  date        String // "YYYY-MM-DD" en timezone del workspace
  titulo      String
  mensaje     String
  sugerencia  String?
  alertaRol   String?
  alertaGTD   String?
  tono        String // warning | alert | positive | neutral
  feedback    String? // "up" | "down" | null
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId, date])
  @@index([userId])
  @@index([workspaceId])
}

// Pizarra de notas: una fila por columna (0-2) por usuario+workspace.
// Sincroniza el contenido HTML de la pizarra entre dispositivos.
model NotesBoardNote {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  columnIndex Int // 0, 1, 2
  content     String    @default("") @db.Text
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId, columnIndex])
  @@index([userId])
  @@index([workspaceId])
}

model UserInsightMemory {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  workspaceId     Int
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  tendencias      String    @default("")
  fortalezas      String    @default("")
  areasDeAtencion String    @default("")
  estadisticas    Json      @default("{}")
  weekStart       String    @default("") // YYYY-MM-DD
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, workspaceId, weekStart])
  @@index([userId])
  @@index([workspaceId])
}

model AiTokenLog {
  id           Int        @id @default(autoincrement())
  workspaceId  Int?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  service      String // "insight" | "weeklyReport" | "insightMemory"
  userId       Int?
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([workspaceId])
  @@index([workspaceId, createdAt]) // agregación de presupuesto de tokens por workspace + mes (hot path)
}

// ─── ROLES IA ─────────────────────────────────────────────────────────────────

model RoleExpectation {
  id                          Int       @id @default(autoincrement())
  workspaceId                 Int
  workspace                   Workspace @relation(fields: [workspaceId], references: [id])
  roleName                    String
  description                 String    @default("")
  expectedResults             Json      @default("[]")
  operationalResponsibilities Json      @default("[]")
  recurrentTasks              Json      @default("[]")
  dependencies                Json      @default("[]")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@unique([workspaceId, roleName])
  @@index([workspaceId])
}

// ─── EMAIL LOG ───────────────────────────────────────────────────────────────

model EmailLog {
  id          Int        @id @default(autoincrement())
  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  to          String // destinatario(s), puede ser comma-separated
  subject     String
  type        String // passwordReset | welcome | weeklySummary | testSettings | invitation | deletionWarning
  status      String     @default("sent") // sent | failed
  errorMsg    String?
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
  @@index([createdAt])
  @@index([status])
}

// ─── ELIMINACIÓN DE WORKSPACE ────────────────────────────────────────────────

model WorkspaceDeletionRequest {
  id            Int       @id @default(autoincrement())
  workspaceId   Int       @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  requestedById Int
  requestedBy   User      @relation("DeletionRequestedBy", fields: [requestedById], references: [id])
  scheduledAt   DateTime // requestedAt + 48h
  cancelledAt   DateTime?
  cancelledById Int?
  cancelledBy   User?     @relation("DeletionCancelledBy", fields: [cancelledById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([scheduledAt])
