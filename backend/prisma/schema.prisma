}

// ─── KEYWORD TRACKING ─────────────────────────────────────────────────────────

model TrackedKeyword {
  id                Int       @id @default(autoincrement())
  projectId         Int
  workspaceId       Int
  query             String
  analysisContent   String? // JSON output de Claude (cacheado)
  analysisUpdatedAt DateTime?
  createdAt         DateTime  @default(now())

  project       Project          @relation("ProjectTrackedKeywords", fields: [projectId], references: [id], onDelete: Cascade)
  workspace     Workspace        @relation("WorkspaceTrackedKeywords", fields: [workspaceId], references: [id], onDelete: Cascade)
  rankings      KeywordRanking[]
  serpSnapshots SerpSnapshot[]
  marketingObjectives MarketingObjective[]

  @@unique([projectId, query])
  @@index([projectId, workspaceId])
}

model KeywordRanking {
  id               Int      @id @default(autoincrement())
  trackedKeywordId Int
  projectId        Int
  workspaceId      Int
  month            String // "2026-04"
  clicks           Int      @default(0)
  impressions      Int      @default(0)
  ctr              Float    @default(0)
  position         Float    @default(0)
  createdAt        DateTime @default(now())

  trackedKeyword TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  project        Project        @relation("ProjectKeywordRankings", fields: [projectId], references: [id], onDelete: Cascade)
  workspace      Workspace      @relation("WorkspaceKeywordRankings", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([trackedKeywordId, month])
  @@index([projectId, workspaceId])
}

// ─── SERP SNAPSHOTS ───────────────────────────────────────────────────────────

model SerpSnapshot {
  id               Int      @id @default(autoincrement())
  trackedKeywordId Int
  projectId        Int
  workspaceId      Int
  capturedAt       DateTime @default(now())

  position  Int? // null = no aparece en top 100
  resultUrl String? // URL exacta que rankea

  // JSON serializado (arrays)
  serpFeatures    String @default("[]") // ["featured_snippet", "ai_overview", ...]
  competitors     String @default("[]") // [{ position, domain, url, title }]
  peopleAlsoAsk   String @default("[]") // [string]
  relatedSearches String @default("[]") // [string]

  country      String  @default("ar") // código SerpAPI (gl)
  totalResults String?

  trackedKeyword TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)

  @@index([trackedKeywordId, capturedAt])
  @@index([projectId, workspaceId])
}

// ─── INSTAGRAM SNAPSHOTS ──────────────────────────────────────────────────────

model InstagramSnapshot {
  id             Int      @id @default(autoincrement())
  projectId      Int
  workspaceId    Int
  month          String // "YYYY-MM"
  followersCount Int      @default(0)
  mediaCount     Int?
  avgLikes       Float?
  avgComments    Float?
  engagementRate Float?
  postsCount     Int? // publicaciones nuevas en ese mes
  reach          Int? // alcance único de la cuenta en el mes (Insights)
  views          Int? // vistas/impresiones de la cuenta en el mes (Insights)
  totalSaved     Int? // guardados sumados de las publicaciones del mes (Insights)
  totalShares    Int? // compartidos sumados de las publicaciones del mes (Insights)
  avgReach       Float? // alcance promedio por publicación del mes (Insights)
  topPosts       String   @default("[]") // JSON: [{ id, likeCount, commentsCount, reach, saved, shares, views, imgSrc, permalink, mediaType, caption, timestamp }]
  createdAt      DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([workspaceId])
}

// ─── SOCIAL IMAGE (cache de imágenes de RRSS) ─────────────────────────────────
// Las URLs de imágenes de los CDN de Instagram/Facebook/TikTok vienen firmadas y
// vencen (horas/días). Para que los top posts de snapshots e informes no queden
// con la imagen rota ("URL signature expired"), al capturar un snapshot
// descargamos los bytes mientras la URL es válida y los servimos desde acá.
model SocialImage {
  id          String   @id @default(uuid())
  workspaceId Int
  sourceUrl   String   @db.Text // URL original del CDN (referencia/dedup)
  imageData   Bytes
  mimeType    String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── INSTAGRAM FOLLOWER LOG ───────────────────────────────────────────────────

model InstagramFollowerLog {
  id             Int      @id @default(autoincrement())
  projectId      Int
  workspaceId    Int
  date           String // "YYYY-MM-DD" en horario ART
  followersCount Int
  createdAt      DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([workspaceId])
}

// Competidores de RRSS — cuentas de la competencia que se trackean por scraping.
// Por ahora solo Instagram (platform = "instagram").
model CompetitorAccount {
  id            Int      @id @default(autoincrement())
