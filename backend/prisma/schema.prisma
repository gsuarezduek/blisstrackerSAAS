  avgComments    Float?
  engagementRate Float?
  topPosts       String   @default("[]") // JSON con top publicaciones
  createdAt      DateTime @default(now())

  competitor CompetitorAccount @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, month])
  @@index([workspaceId])
  @@index([competitorId])
}

model CompetitorFollowerLog {
  id             Int      @id @default(autoincrement())
  competitorId   Int
  workspaceId    Int
  date           String // "YYYY-MM-DD" en horario ART
  followersCount Int
  createdAt      DateTime @default(now())

  competitor CompetitorAccount @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, date])
  @@index([workspaceId])
  @@index([competitorId])
}

