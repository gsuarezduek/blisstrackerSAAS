  role      String   @default("")
  company   String   @default("")
  quote     String
  metric    String?
  photoData Bytes?
  mimeType  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TrustedCompany {
  id         Int      @id @default(autoincrement())
  name       String
  websiteUrl String?
  imageData  Bytes
  mimeType   String   @default("image/png")
  order      Int      @default(0)
  active     Boolean  @default(true)
