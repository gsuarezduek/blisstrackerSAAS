// ─── ADS SNAPSHOTS ───────────────────────────────────────────────────────────

model AdsSnapshot {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  month       String // "YYYY-MM"
  type        String // "meta_ads" | "google_ads"

  // Métricas comunes
  spend       Float @default(0) // gasto total en USD
  impressions Int   @default(0)
  clicks      Int   @default(0)
  ctr         Float @default(0) // porcentaje (ej: 2.5 = 2.5%)

  // Meta Ads específico
  reach Int? // alcance único
  cpm   Float? // costo por 1000 impresiones
  cpc   Float? // costo por click

  // Google Ads específico
  conversions Float? // conversiones totales
  avgCpc      Float? // CPC promedio

  // Top campañas (JSON): [{ id, name, spend, impressions, clicks, ctr }]
  topCampaigns String @default("[]")

  // Top anuncios individuales (JSON):
  //   Meta:   [{ id, name, thumbnailUrl, reach, impressions, clicks, ctr, spend }]
  //   Google: [{ id, name, type, headline, description, impressions, clicks, ctr, cost, conversions }]
  // La thumbnailUrl de Meta se cachea (SocialImage/R2) al guardar el snapshot.
  topAds String @default("[]")

  // Metadata
  currency       String @default("USD")
  campaignsCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month, type])
  @@index([workspaceId])
  @@index([projectId])
}

// Último resultado del Ads Advisor (diagnóstico + copys IA) por proyecto+plataforma.
// generateAdsAdvisor() sigue siendo 100% on-demand (no dispara nada automático) — esto
// solo cachea el último resultado para que el panel "Hoy" pueda leerlo sin volver a
// pegarle a Claude. Upsert por (projectId, platform), se pisa en cada nuevo análisis.
model AdsAdvisorResult {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  platform    String // "meta_ads" | "google_ads"

  diagnostico String // JSON: [{ ambito, referencia, tipo, prioridad, titulo, detalle }]
  nuevosCopys String // JSON: [{ angulo, headline, texto, motivo }]
  generatedAt DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, platform])
  @@index([workspaceId])
}

// Cache del último diagnóstico del RRSS Advisor (IA), análogo a AdsAdvisorResult pero
// para Instagram/TikTok/LinkedIn/Facebook/YouTube. Sin `nuevosCopys` — v1 solo genera
// diagnóstico, no ideas de contenido nuevo (ver rrssAdvisor.service.js).
model RrssAdvisorResult {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  platform    String // "instagram" | "tiktok" | "linkedin" | "facebook" | "youtube"

  diagnostico String // JSON: [{ tipo, prioridad, titulo, detalle }]
  generatedAt DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, platform])
  @@index([workspaceId])
}

// Recomendación descartada del panel "Hoy" (marketingPending.service.js). `signature` es
// el título normalizado (trim+lowercase+espacios colapsados) — para fuentes deterministas
// (canibalización, keywords, contenido, objetivos) es 100% estable; para GEO y Ads Advisor
// (texto libre de IA) sobrevive solo si la redacción no cambia entre corridas. `title`
// queda sin normalizar, únicamente para mostrar en "ver ignorados".
model DismissedFinding {
  id            Int      @id @default(autoincrement())
  workspaceId   Int
  projectId     Int
  source        String // 'geo' | 'cannibal' | 'pagespeed' | 'keywords' | 'objective' | 'content' | 'ads_advisor'
  signature     String
  title         String
  dismissedById Int?
  dismissedAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dismissedBy User?     @relation(fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([projectId, source, signature])
  @@index([workspaceId])
}

// ─── MONTHLY REPORT ──────────────────────────────────────────────────────────

model MonthlyReport {
  id             Int      @id @default(autoincrement())
  projectId      Int
  workspaceId    Int
  month          String // "YYYY-MM" — ancla estable de id/URL. El NOMBRE visible sale del período (periodStart/End).
  periodStart    DateTime? // Inicio del período de datos (fecha real). null en informes legacy → se deriva del mes completo prevMonthStr(month).
  periodEnd      DateTime? // Fin del período de datos (fecha real). null en legacy → último día de prevMonthStr(month).
  status         String   @default("draft") // "draft" | "published" — el link público solo sirve informes publicados
  token          String   @unique
  objectives     String   @default("{}") // JSON: { sessions, followersIg, followersTk, ... }
  notes          String?
  analysis       String? // JSON: { resumen, highlights, alertas, nextSteps } — cacheado, no se regenera
  dataCache      String? // JSON: secciones agregadas (analytics, ads, instagram, seo, etc.) — caché para evitar llamadas repetidas a APIs
  enabledSections String? // JSON: array de secciones a incluir (ej: ["analytics","instagram"]). null = informe aún no generado
  bannerData     Bytes? // Imagen de portada del informe (PNG/JPG/WebP, max 5MB)
  bannerMimeType String? // ej: "image/jpeg"
  generatedById  Int? // usuario que generó o regeneró el informe por última vez
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy User?     @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  feedback    ReportFeedback[]

  @@unique([projectId, month])
  @@index([workspaceId])
}

// ─── FEEDBACK DEL CLIENTE SOBRE EL INFORME ─────────────────────────────────────
// El cliente (sin auth, desde el link público) califica el informe 1–5 estrellas
// + comentario opcional. Se ve desde la vista admin del informe.
model ReportFeedback {
  id          Int      @id @default(autoincrement())
  reportId    Int
  workspaceId Int
  name        String? // nombre que el cliente ingresa (opcional)
  rating      Int // 1..5 estrellas
  comment     String?
  createdAt   DateTime @default(now())

  report    MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([workspaceId])
}

// ─── PORTAL DE CLIENTE ─────────────────────────────────────────────────────────
// Acceso externo, por proyecto, para un cliente que no es User/WorkspaceMember
// (así queda afuera de RRHH/Productividad/Equipo por diseño). URL pública con
// slug propio (reemplaza el token UUID de MonthlyReport como puerta de entrada
// estable): Informes + Briefs abiertos sin login; "Datos en vivo" gateado por
// código OTP enviado al email del cliente.
model ProjectClientPortal {
  id               Int       @id @default(autoincrement())
  workspaceId      Int
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        Int       @unique // un portal por proyecto (v1)
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug             String    @unique // vanity slug, global (mismo criterio que MonthlyReport.token)
  // LEGACY: la fuente de verdad del login OTP es ClientPortalContact. Se conserva
  // nullable un release por rollback; se dropea en una migración posterior.
  clientEmail      String?
  clientName       String?
  active           Boolean   @default(true)
  contentEnabled   Boolean   @default(false) // habilita el tab "Contenido" (aprobación de piezas)
  showMeetings     Boolean   @default(false) // opt-in: expone fecha/título (sin notas) de la próxima reunión tipo 'client' en "Inicio"
  showTeam         Boolean   @default(false) // opt-in: expone el equipo del proyecto (ProjectMember: foto/nombre/rol) en "Tu equipo"
  showObjectives   Boolean   @default(false) // opt-in: expone el cumplimiento de MarketingObjective (computeObjectives, en vivo) arriba de las tarjetas en "Inicio"
  bannerData       Bytes? // Imagen hero del portal (PNG/JPG/WebP, max 5MB) — reemplaza al viejo banner por informe (MonthlyReport.bannerData, deprecado)
  bannerMimeType   String? // ej: "image/jpeg"
  liveSections     String    @default("[]") // JSON array, subset de SECTION_KEYS habilitado para "Datos en vivo"
  liveDataCache    String? // JSON: último resultado de aggregateReportData (sections/objectives/period)
  liveDataCachedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  loginCodes ClientPortalLoginCode[]
  contacts   ClientPortalContact[]

  @@index([workspaceId])
}

// Contactos autorizados de un portal. Fuente de verdad del login OTP (reemplaza a
// ProjectClientPortal.clientEmail, que quedó legacy). Un contacto NO es un User:
// queda fuera de RRHH/Equipo/Productividad por diseño, igual que el portal.
// Desactivarlo corta el acceso al instante, incluso con el JWT de 30 días vigente
// (clientPortalAuth revalida el contacto en cada request).
model ClientPortalContact {
  id          Int                 @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  portalId    Int
  portal      ProjectClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  email       String // siempre normalizado a lowercase
  name        String?
  canApprove  Boolean             @default(true)
  active      Boolean             @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  loginCodes     ClientPortalLoginCode[]
  approvedPieces ContentPiece[]
  comments       ContentComment[]
  statusEvents   ContentStatusEvent[]

  @@unique([portalId, email]) // el mismo email puede ser contacto de varios proyectos
  @@index([portalId, active])
  @@index([workspaceId])
}

// Códigos OTP de un solo uso para desbloquear "Datos en vivo" del portal de cliente.
model ClientPortalLoginCode {
  id        Int      @id @default(autoincrement())
  portalId  Int
  portal    ProjectClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  contactId Int?
  contact   ClientPortalContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // El rate limit del OTP es por (portal, email) y no por portal: con varios
  // contactos, un límite por portal se agotaría con un login de cada uno.
  @@index([portalId, email, createdAt])
}

// ─── OBJETIVOS DE MARKETING ───────────────────────────────────────────────────
// Objetivos estructurados y persistentes por proyecto (se mantienen mes a mes
// hasta editarse/eliminarse). El informe compara el resultado real contra el
// target según la periodicidad (mensual/trimestral/anual, calendario).
model MarketingObjective {
  id          Int    @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  category    String // "web" | "seo" | "rrss" | "ads"
  metric      String // leads | visitas | performance | posicionamiento | seguidores | interaccion | competidores | inversion | clicks | ctr
  periodicity String // "monthly" | "quarterly" | "annual"
  target      Float

  // Params opcionales según la métrica
  platform         String? // ads: "meta_ads" | "google_ads"
  trackedKeywordId Int? // seo/posicionamiento
  competitorId     Int? // rrss/competidores

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trackedKeyword TrackedKeyword?    @relation(fields: [trackedKeywordId], references: [id], onDelete: SetNull)
  competitor     CompetitorAccount? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workspaceId])
}

// ─── BRIEFS ───────────────────────────────────────────────────────────────────
// Cuestionarios de relevamiento por proyecto. Se completan modularmente (no es
// necesario completar todos ni todos los campos). Una fila por (proyecto, tipo).
// `answers` es un JSON { fieldKey: valor }. Catálogo de tipos y campos en
// backend/src/lib/briefCatalog.js (y espejo en frontend para el render).

model ProjectBrief {
  id          Int    @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  type        String // "marca" | "organico" | "meta_ads" | "web" | "seo_sem" | "crm"
  answers     Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId])
  @@index([workspaceId])
}

// Content Brief de SEO generado por IA para una keyword objetivo.
// Combina datos del SERP (SerpAPI) con los briefs seo_sem + marca del proyecto.
// content = JSON { titulo, metaDescription, intencion, audiencia, anguloDiferencial,
//                  longitudObjetivo, estructura:[{h,titulo,nota}], preguntas:[], entidades:[],
//                  enlacesInternos, notasEEAT }
model ContentBrief {
  id          Int    @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  keyword     String
  content     String // JSON generado por IA

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, keyword])
  @@index([projectId, createdAt])
  @@index([workspaceId])
}

// Auditoría On-Page de SEO: crawlea varias páginas del sitio y evalúa factores
// on-page (title, meta, H1, headings, alt, canonical, thin content, enlaces rotos)
// + sugerencias de enlazado interno con IA. Patrón async idéntico a GeoAudit.
// findings = JSON [{severity, category, title, description, url?, action?}]
// pages    = JSON [{url, status, title, score, issues:[{code,sev,msg}], wordCount, ...}]
// linkSuggestions = JSON [{from, to, anchor, reason}]
model OnPageAudit {
  id           Int    @id @default(autoincrement())
  workspaceId  Int
  projectId    Int
  status       String @default("pending") // pending|running|completed|failed
  score        Int?
  pagesCrawled Int?

  findings        String @default("[]")
  pages           String @default("[]")
  linkSuggestions String @default("[]")

  errorMsg   String? // progreso en vivo mientras running, mensaje de error si failed
  tokensUsed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([workspaceId])
}

// Content Gap: compara la página propia que rankea para una keyword contra las de
// los competidores del SERP y detecta temas/secciones/entidades faltantes (crawl + IA).
// competitors       = JSON [{domain, url, title, position, wordCount, headingsCount}]
// gaps              = JSON [{tema, tipo, descripcion, prioridad}]
// headingsSuggested = JSON [string]
model ContentGap {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  keyword     String
  status      String @default("pending") // pending|running|completed|failed
  ownUrl      String?
  ownPosition Int?

  competitors       String  @default("[]")
  gaps              String  @default("[]")
  headingsSuggested String  @default("[]")
  summary           String?

  errorMsg   String?
  tokensUsed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([workspaceId])
}

// Reuniones por proyecto (formato similar a la L10 de EOS, pero sin puntaje).
// Cada reunión es un evento con fecha, tipo (interna/cliente), notas libres,
// cronómetro de inicio/fin (duración) y to-dos con responsable que se pueden
// enviar al dashboard (igual que los To-Dos de L10).
model ProjectMeeting {
  id          Int      @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  date        String // "YYYY-MM-DD"
  title       String? // título opcional de la reunión (para identificarla entre varias)
  type        String   @default("internal") // 'internal' (equipo) | 'client' (cliente)
  notes       String? // HTML del editor de notas
  startedAt   DateTime? // cronómetro: arranca al iniciar la reunión
  endedAt     DateTime? // cronómetro: se setea al finalizar
  durationMins Int? // duración en minutos, congelada al finalizar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace    Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  todos        ProjectMeetingTodo[]
  participants ProjectMeetingParticipant[]

  @@index([projectId])
  @@index([workspaceId])
}

// Participante de una reunión de proyecto. Al iniciar la reunión se crea una Task
// IN_PROGRESS por participante (su tiempo cuenta para el proyecto y aparece en
// Actividad); al finalizar se completa. `taskId` apunta a esa tarea (uno a uno).
model ProjectMeetingParticipant {
  id          Int      @id @default(autoincrement())
  meetingId   Int
  workspaceId Int
  userId      Int
  taskId      Int?     @unique
  createdAt   DateTime @default(now())

  meeting   ProjectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation("MeetingParticipant", fields: [userId], references: [id], onDelete: Cascade)
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([workspaceId])
}

// To-Do de una reunión de proyecto. Espejo de EOSTodo: se vincula a una Task del
// dashboard (uno a uno); completar esa tarea tilda el to-do, reabrirla lo destilda.
model ProjectMeetingTodo {
  id          Int       @id @default(autoincrement())
  meetingId   Int
  workspaceId Int
  title       String
  ownerId     Int?
  done        Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  taskId      Int?      @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting   ProjectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?          @relation("MeetingTodoOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([workspaceId])
}

// ─── SEO SNAPSHOTS ────────────────────────────────────────────────────────────

model SearchConsoleSnapshot {
  id          Int    @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  month       String // "YYYY-MM"

  clicks      Int    @default(0)
  impressions Int    @default(0)
  ctr         Float  @default(0)
  avgPosition Float  @default(0)
  devices     String @default("{}") // JSON: {DESKTOP:{clicks,impressions}, MOBILE:{...}, TABLET:{...}}
  countries   String @default("[]") // JSON: [{country, clicks, impressions}]
  topQueries  String @default("[]") // JSON: [{query, clicks, impressions, ctr, position}]
  topPages    String @default("[]") // JSON: [{page, clicks, impressions, ctr, position}]
  domainRating Float? // Ahrefs Domain Rating (0-100) al momento del snapshot — histórico mensual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([workspaceId])
  @@index([projectId])
}

model SeoAiInsight {
  id          Int      @id @default(autoincrement())
  projectId   Int      @unique
  workspaceId Int
  // JSON: { titulo, resumen, oportunidades:[{pagina,accion,impacto,razon}], quickWins:[{titulo,descripcion,tarea}] }
  content     String
  generatedAt DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── CANIBALIZACIÓN SEO ──────────────────────────────────────────────────────

model CannibalReport {
  id          Int    @id @default(autoincrement())
  projectId   Int
  workspaceId Int
  status      String @default("pending") // pending | running | completed | failed
  dateRange   String @default("90d") // "30d" | "90d" | "180d"

  totalConflicts Int?
  criticalCount  Int?
  warningCount   Int?
  lowCount       Int?
  trafficAtRisk  Int? // impresiones en riesgo (suma de conflictos críticos + warning)

  // JSON: [{ query, urls:[{url,clicks,impressions,ctr,position}], severity, severityScore,
  //          totalImpressions, totalClicks, positionSpread, recommendation }]
  conflicts String @default("[]")

  resumenGeneral String? // análisis IA resumido
  errorMsg       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
  @@index([workspaceId])
}

// ─── EOS (Entrepreneurial Operating System) ──────────────────────────────────

model EOSData {
  id          Int     @id @default(autoincrement())
  workspaceId Int     @unique
  coreValues  String  @default("[]") // JSON: string[]
  // Visión — Enfoque Medular
  purpose     String? // Propósito / Causa / Pasión
  niche       String? // Nicho de la organización

  // Visión — Meta a 10 años
  tenYearTarget String?

  // Visión — Estrategia de Marketing
  marketingTarget    String? // Cliente ideal / La Lista
  marketingUniques   String  @default("[]") // JSON: string[] — 3 diferenciadores
  marketingProcess   String? // Proceso probado
  marketingGuarantee String? // Garantía

  // Visión — Imagen a 3 años
  threeYearRevenue     String?
  threeYearProfit      String?
  threeYearHeadcount   String?
  threeYearDescription String?
  threeYearGoals       String  @default("[]") // JSON: string[]

  // Visión — Plan a 1 año
  oneYearDate    String? // Fecha de realización (YYYY-MM-DD)
  oneYearRevenue String?
  oneYearProfit  String?
  oneYearGoals   String   @default("[]") // JSON: string[] (Rocks)

  // Reuniones L10 — proyecto por defecto donde se crean las tareas de los participantes
  meetingProjectId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetingProject Project?  @relation("EOSMeetingProject", fields: [meetingProjectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ─── EOS — PERSONAS ───────────────────────────────────────────────────────────

model PeopleAnalyzerRating {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  userId      Int
  valueKey    String // texto del valor medular o 'gwc_get'/'gwc_want'/'gwc_capacity'
  rating      String // '+' | '+/-' | '-'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("AnalyzedPerson", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, valueKey])
  @@index([workspaceId])
  @@index([userId])
}

model EOSStrike {
  id           Int      @id @default(autoincrement())
  workspaceId  Int
  userId       Int
  strikeNumber Int // 1, 2 o 3 (asignado automáticamente)
  reason       String
  createdById  Int
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("StrikedPerson", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User      @relation("StrikeCreator", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@index([userId])
}

model AccountabilityNode {
  id               Int      @id @default(autoincrement())
  workspaceId      Int
  parentId         Int?
  seat             String
  userId           Int?
  accountabilities String   @default("[]") // JSON: string[]
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?                @relation("SeatHolder", fields: [userId], references: [id], onDelete: SetNull)
  parent    AccountabilityNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  AccountabilityNode[] @relation("NodeHierarchy")

  @@index([workspaceId])
  @@index([parentId])
}

// ─── EOS SCORECARD ────────────────────────────────────────────────────────────

model ScorecardMetric {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String
  ownerId     Int?
  goal        Float?
  lowerIsBetter Boolean @default(false) // true = menor es mejor (ej: tardanzas); verde cuando value <= goal
  unit        String?
  frequency   String   @default("weekly") // 'weekly' | 'monthly'
  autoKey     String?  // null = métrica manual; 'tardanzas' | 'ocupacion' = automática (valores calculados por el sistema, no se cargan a mano)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?            @relation("MetricOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  entries   ScorecardEntry[]

  @@unique([workspaceId, autoKey]) // a lo sumo una métrica automática por tipo y workspace (NULLs distintos en Postgres → no afecta a las manuales)
  @@index([workspaceId])
}

model ScorecardEntry {
  id          Int      @id @default(autoincrement())
  metricId    Int
  workspaceId Int
  period      String // 'YYYY-Www' semanal | 'YYYY-MM' mensual
  value       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metric    ScorecardMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([metricId, period])
  @@index([metricId])
  @@index([workspaceId])
}

// ─── EOS PROCESOS ─────────────────────────────────────────────────────────────

model EOSProcess {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String
  ownerRole   String? // nombre del rol responsable (referencia a UserRole.name)
  status      String   @default("not_started") // 'not_started' | 'documented' | 'followed'
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     EOSProcessStep[]

  @@index([workspaceId])
}

model EOSProcessStep {
  id          Int      @id @default(autoincrement())
  processId   Int
  workspaceId Int
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  process   EOSProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([workspaceId])
}

model EOSIssue {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  title       String
  description String?
  ownerId     Int?
  createdById Int?
  type        String    @default("weekly") // 'weekly' | 'quarterly'
  status      String    @default("open") // 'open' | 'solved'
  priority    String    @default("medium") // 'high' | 'medium' | 'low'
  notes       String?
  solvedAt    DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("IssueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([type, status])
}

model EOSRock {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  title       String
  description String?
  ownerId     Int?
  quarter     String // "2026-Q2"
  status      String   @default("not_started") // not_started | on_track | off_track | complete
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("RockOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([quarter])
}

model EOSTodo {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  title       String
  ownerId     Int?
  week        String // "2026-W18" ISO
  done        Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  // Tarea del dashboard vinculada (uno a uno). Al completar esa tarea se tilda el
  // To-Do; al reabrirla se destilda. SetNull: si se borra la tarea, el To-Do queda.
  taskId      Int?      @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("TodoOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, week])
}

model EOSMeeting {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  week        String // "2026-W18"
  date        String? // "2026-05-06"
  notes       String?
  type        String   @default("weekly") // 'weekly' | 'quarterly' | 'annual'
  startedAt    DateTime? // cronómetro: arranca al iniciar la reunión
  endedAt      DateTime? // cronómetro: se setea al finalizar
  durationMins Int? // duración en minutos, congelada al finalizar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants EOSMeetingParticipant[]

  @@unique([workspaceId, week])
  @@index([workspaceId])
}

// Participante de una reunión L10 de EOS. Al iniciar la reunión se crea una Task
// IN_PROGRESS por participante (su tiempo cuenta para el proyecto de reuniones y
// aparece en Actividad); al finalizar se completa. Espejo de ProjectMeetingParticipant.
model EOSMeetingParticipant {
  id          Int      @id @default(autoincrement())
  meetingId   Int
  workspaceId Int
  userId      Int
  taskId      Int?     @unique
  createdAt   DateTime @default(now())

  meeting   EOSMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation("EOSMeetingParticipant", fields: [userId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([workspaceId])
}

model OrgAssessmentRound {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  status      String    @default("open") // open | closed
  resultData  String? // JSON: { scores, categoryAverages, totalAverage, analysis, respondentCount }
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses OrgAssessmentResponse[]

  @@index([workspaceId])
}

model OrgAssessmentResponse {
  id          Int      @id @default(autoincrement())
  roundId     Int
  workspaceId Int
  userId      Int
  answers     String   @default("[]") // JSON: [{questionId, score}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  round     OrgAssessmentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([roundId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── CONFIGURACIÓN GLOBAL DE LA PLATAFORMA ────────────────────────────────────

model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  description String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PlatformSettingLog {
  id          Int      @id @default(autoincrement())
  settingKey  String
  oldValue    Json?
  newValue    Json
  changedById Int
  changedBy   User     @relation("SettingChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([settingKey, createdAt])
}

// ─── EVENTOS DE CONVERSIÓN (analytics simple cross-funnel) ───────────────────

model ConversionEvent {
  id          Int      @id @default(autoincrement())
  workspaceId Int?
  userId      Int?
  name        String // ej: 'landing_cta_click', 'signup_completed', 'first_task_created'
  params      Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([workspaceId])
}

// ─── GAMIFICATION (juegos/desafíos del workspace) ────────────────────────────
// Módulo gateado por el feature flag `gamification`. El catálogo de TIPOS de
// juego vive en código (backend/src/lib/gameCatalog.js, espejo en el frontend);
// el admin crea INSTANCIAS (Game) eligiendo un tipo y configurándolo.
// Cada juego es autónomo: su propio ranking, ganador y premio (sin temporada
// acumulada). Sujetos posibles: proyectos, personas o equipos custom.

model Game {
  id             Int       @id @default(autoincrement())
  workspaceId    Int
  type           String // key del catálogo (gameCatalog.js)
  title          String // enunciado del desafío
  description    String?   @db.Text
  prize          String? // premio (texto libre)
  subjectType    String // "project" | "person" | "team"
  scoring        String // "auto_metric" | "vote" | "manual"
  config         Json      @default("{}") // params del tipo (métrica, candidateIds, projectIds, etc.)
  visibilityRule Json      @default("{}") // { mode: "always" | "date_range" | "recurring", ... }
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("draft") // "draft" | "active" | "finished" | "archived"
  sortOrder      Int       @default(0) // orden manual (asc); a igualdad, createdAt desc. Gestionado desde el panel admin.
  finishedAt     DateTime? // cuándo se finalizó (define la ventana de "recién finalizado" del FAB, independiente de updatedAt)
  winnerSubject  Json? // ganador resuelto al finalizar: { subjectId, label, score }
  imageData      Bytes? // imagen/banner opcional del juego (se omite en los listados)
  imageMimeType  String?
  createdById    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams           GameTeam[]
  votes           GameVote[]
  scores          GameScore[]
  questions       GameQuestion[]
  quizSubmissions GameQuizSubmission[]
  notifications   Notification[]

  @@index([workspaceId, status])
}

// Pregunta de un juego de tipo cuestionario (scoring = "quiz").
// kind = "multiple_choice" (una opción correcta, suma puntos) | "open" (respuesta
// de texto libre, informativa: se guarda para que la lea el admin, no puntúa).
model GameQuestion {
  id              String   @id @default(uuid())
  gameId          Int
  order           Int      @default(0)
  kind            String   @default("multiple_choice") // "multiple_choice" | "open"
  text            String   @db.Text
  options         Json     @default("[]") // [{ id, text }] — vacío en preguntas abiertas
  correctOptionId String? // id de la opción correcta dentro de `options` — null en preguntas abiertas
  points          Float    @default(1)
  createdAt       DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

// Respuestas de una persona a un cuestionario. Una sola entrega por persona.
model GameQuizSubmission {
  id          String   @id @default(uuid())
  gameId      Int
  userId      Int
  answers     Json     @default("[]") // [{ questionId, optionId }]
  score       Float    @default(0)
  submittedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
}

// Equipos custom definidos por el admin POR juego (cuando subjectType = "team").
model GameTeam {
  id         String   @id @default(uuid())
  gameId     Int
  name       String
  memberIds  Json     @default("[]") // [userId, ...]
  projectIds Json     @default("[]") // [projectId, ...]
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

// Votos (scoring = "vote"). Un voto por persona por juego; sin auto-voto (validado en el controller).
model GameVote {
  id           Int      @id @default(autoincrement())
  gameId       Int
  voterId      Int // quién vota
  targetUserId Int // a quién vota
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, voterId])
  @@index([gameId])
}

// Puntajes manuales (scoring = "manual"). El admin carga puntos por sujeto.
model GameScore {
  id          Int      @id @default(autoincrement())
  gameId      Int
  subjectType String // "project" | "person" | "team"
  subjectId   String // id del sujeto (projectId/userId/teamId como string)
  label       String? // etiqueta editable (ej. nombre de un sujeto manual)
  points      Float    @default(0)
  detail      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, subjectId])
  @@index([gameId])
}

// ─────────────────────────────────────────────────────────────
// Módulo Ventas (CRM)
// Estados/orígenes/tipos de evento se centralizan en backend/src/lib/salesCatalog.js
// (espejo en frontend/src/components/ventas/salesCatalog.js). El CRM separa Empresa /
// Contacto / Lead para poder crecer hacia un CRM completo (ver pipeline/forecast futuros).
// ─────────────────────────────────────────────────────────────

// Empresa: una cuenta comercial. Puede tener múltiples contactos y múltiples leads.
model Company {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  website     String? // sitio web
  industry    String? // rubro (opcional)
  notes       String? // observaciones
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contacts Contact[]
  leads    Lead[]

  @@index([workspaceId])
}

// Contacto: una persona dentro de una empresa. N contactos por empresa.
model Contact {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  title       String? // cargo
  email       String?
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  primaryForLeads Lead[] @relation("LeadPrimaryContact")
  whatsappConversations WhatsappConversation[]

  @@index([workspaceId])
  @@index([companyId])
}

// Lead / Oportunidad comercial. Asociado a una empresa + contacto principal + responsable.
model Lead {
  id               Int       @id @default(autoincrement())
  workspaceId      Int
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId        Int
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryContactId Int?
  primaryContact   Contact?  @relation("LeadPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  ownerId          Int? // responsable comercial (User)
  owner            User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  title          String? // título de la oportunidad (opcional; si falta se muestra el nombre de la empresa)
  status         String    @default("prospecto") // catálogo salesCatalog LEAD_STATUSES
  origin         String? // catálogo salesCatalog LEAD_ORIGINS
  estimatedValue Float? // valor estimado
  currency       String    @default("ARS")
  nextContactAt  DateTime? // próximo contacto (seguimiento)
  notes          String? // notas de reunión, HTML del WYSIWYG (separado del timeline de LeadActivity)

  // Conversión a cliente (estado Ganado → Crear Proyecto)
  convertedProjectId Int?     @unique
  convertedProject   Project? @relation("LeadConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  wonAt              DateTime?
  lostAt             DateTime?
  lostReason         String?

  // Archivado: saca al lead del Pipeline/lista principal sin borrarlo (a diferencia de
  // delete, conserva historial/métricas). Manual, sin restricción de estado.
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  archivedReason String? // motivo opcional, para poder evaluar patrones después

  createdById Int?
  createdBy   User?    @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities    LeadActivity[]
  proposals     Proposal[]
  researches    LeadResearch[]
  actions       LeadAction[]
  notifications Notification[]
  whatsappAutomationLogs WhatsappAutomationLog[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, archived])
  @@index([companyId])
  @@index([ownerId])
}

// Próxima(s) acción(es) de un lead: reemplaza al viejo campo único nextAction*
// (Lead.nextActionTitle/nextActionDueAt/nextActionOwnerId) por una tabla — se
// pueden ir agregando varias, y al resolverlas quedan como historial (status
// 'done' + doneAt/doneBy), en vez de perderse al pisar la siguiente.
// `taskId` vincula la tarea futura auto-creada en el dashboard del responsable
// (uno a uno; sync en ambos sentidos: completar la tarea resuelve la acción y
// resolver la acción completa la tarea, ver tasks.controller.js / leads.controller.js).
model LeadAction {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      Int
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  title   String
  dueAt   DateTime?
  ownerId Int?
  owner   User?     @relation("LeadActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  status   String    @default("pending") // pending | done
  doneAt   DateTime?
  doneById Int?
  doneBy   User?     @relation("LeadActionDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  taskId Int?  @unique
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdById Int?
  createdBy   User?    @relation("LeadActionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([leadId])
  @@index([workspaceId, status, dueAt])
}

// Timeline unificado del lead: notas manuales (kind=note) + eventos automáticos (kind=event).
// "Historial / Notas" = filtrar kind=note; "Timeline" = todo el stream cronológico.
model LeadActivity {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      Int
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      Int? // autor de la nota / actor del evento
  user        User?     @relation("LeadActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  kind        String // "note" | "event"
  type        String? // subtipo de evento (catálogo salesCatalog LEAD_EVENTS); null para notas
  content     String? // texto de la nota o mensaje legible del evento
  meta        Json      @default("{}") // datos estructurados del evento (ej { from, to })
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([leadId, createdAt])
}

// Propuesta comercial generada para un lead. Soporta múltiples versiones por lead.
model Proposal {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      Int
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  title       String?
  services    Json      @default("[]") // unión de nombres de servicios de todos los planes (referencia rápida)
  plans       Json      @default("[]") // planes de precio propuestos: [{ label, price, currency, services: [{ name, description }] }]
  objectives  String? // objetivos del cliente (input del usuario)
  content     String? // propuesta generada por IA (HTML editable)
  signatureId String? // id (dentro de Workspace.salesSignatures) de la firma elegida para esta propuesta
  status      String    @default("draft") // draft | confirmed
  publicToken String    @unique // UUID (crypto.randomUUID(), generado en createProposal, mismo criterio que MonthlyReport.token) — GET /api/public/proposal/:token solo sirve la propuesta si status:'confirmed' (mismo gate draft/published de los Informes)
  createdById Int?
  createdBy   User?     @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([leadId])
}

// Investigación IA de la empresa del lead. Patrón async (setImmediate + progreso en errorMsg + polling).
model LeadResearch {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      Int
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | running | completed | failed
  result      Json? // resultado estructurado de la IA
  errorMsg    String? // progreso mientras running / mensaje de error si failed
  tokensUsed  Int?

  // Informe de diagnóstico para el cliente: HTML persuasivo generado a partir de `result`,
  // pensado como paso previo a la propuesta para captar la atención del dueño/a del negocio.
  // Editable a mano tras generarse; exportable a PDF branded (mismo patrón que Proposal).
  reportTitle String?
  reportHtml  String?

  createdById Int?
  createdBy   User?     @relation("ResearchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([leadId])
}

// ─── CHAT INTERNO ──────────────────────────────────────────────────────────
// Reemplazo progresivo de Discord. Sin tabla de membership: cualquier
// WorkspaceMember activo ve y participa en cualquier canal (mismo criterio
// "equipo = etiqueta, no barrera" ya usado para el acceso a proyectos).
// Las menciones NO tienen tabla propia: son Notification (type CHAT_MENTION),
// igual que TASK_MENTION en comentarios de tareas.

model ChatChannel {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String // "general" | "project" | "custom" — String (no enum): agregar tipos no requiere migración
  slug        String // clave estable en URL, ej "general", "marketing", "proyecto-mdz-rent-a-car"
  name        String? // solo custom/general; los de kind="project" usan project.name (no se duplica)
  description String?
  projectId   Int?      @unique
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  archived    Boolean   @default(false)
  // Canal privado: solo lo ven/usan admin/owner del workspace. Togglea cualquier admin
  // desde un candado en el header del widget (no requiere ser kind="custom" — aplica a
  // cualquier canal, incluido #general y los de proyecto). Ver chat.controller.js.
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages      ChatMessage[]
  reads         ChatChannelRead[]
  notifications Notification[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ChatMessage {
  id          Int         @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId   Int
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // authorId null = mensaje del SISTEMA (no lo escribió una persona): deja constancia de
  // un hito del proyecto (informe generado, brief completo, reunión cerrada, etc.).
  // `systemType` identifica cuál — catálogo en lib/chatSystemMessage.js. Un mensaje
  // normal siempre tiene authorId set y systemType null (o viceversa).
  authorId    Int?
  author      User?       @relation(fields: [authorId], references: [id])
  content     String?     @db.Text // nullable: un mensaje puede ser solo un GIF
  gifUrl      String?
  systemType  String?
  editedAt    DateTime?
  createdAt   DateTime    @default(now())

  // Mensajes fijados: cualquier miembro activo puede fijar/desfijar (sin restricción de
  // autor/admin, a diferencia de editar/borrar). pinnedAt null = no fijado.
  pinnedAt    DateTime?
  pinnedById  Int?
  pinnedBy    User?       @relation("ChatMessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)

  // Responder un mensaje (estilo WhatsApp/Discord): auto-relación, null = no es una
  // respuesta. Si se borra el original, la respuesta queda huérfana (SetNull) en vez de
  // arrastrarla en cascada — el quote simplemente desaparece del mensaje que respondía.
  replyToId   Int?
  replyTo     ChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[] @relation("ChatMessageReplies")

  notifications Notification[]
  reactions     ChatMessageReaction[]

  @@index([channelId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([workspaceId])
  @@index([replyToId])
}

// Reacciones con emoji: cualquier miembro activo puede reaccionar, sin catálogo fijo
// (cualquier emoji vale). Varias reacciones distintas por persona y mensaje conviven;
// repetir el mismo emoji lo saca (toggle, ver chat.controller.js toggleReaction).
model ChatMessageReaction {
  id          Int         @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId   Int
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji       String
  createdAt   DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Resuelve no-leídos SIN un registro de lectura por mensaje: un único row por
// (canal, usuario) con el último mensaje leído. No-leídos = mensajes con
// id > lastReadMessageId. Escala con canales × usuarios activos, no con
// mensajes × usuarios.
model ChatChannelRead {
  id                Int         @id @default(autoincrement())
  workspaceId       Int
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId         Int
  channel           ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  lastReadMessageId Int?
  lastReadAt        DateTime    @default(now())

  @@unique([channelId, userId])
}

// ─── CONTENIDO ────────────────────────────────────────────────────────────────
// Calendario de contenido por proyecto con aprobación del cliente. El workflow de
// estados es FIJO y vive en código (lib/contentCatalog.js) — por eso `status` es
// String y no un enum de Prisma: agregar o renombrar un estado es un cambio de
// catálogo, no una migración de tipo (mismo criterio que Lead.status).

model ContentPiece {
  id            Int       @id @default(autoincrement())
  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     Int
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  status        String    @default("idea") // clave de CONTENT_STATUSES
  type          String    @default("post") // clave de CONTENT_TYPES
  networks      String    @default("[]") // JSON array de claves de CONTENT_NETWORKS (una pieza puede salir a varias)
  // Brief de diseño (WYSIWYG, HTML) — interno, NUNCA viaja al portal del cliente (mismo
  // criterio que internalNotes). Hasta la migración `add_content_piece_design_details`
  // este campo se llamaba `copy` y era el texto del posteo; ese dato viejo quedó acá
  // (envuelto en HTML básico) y `copy` pasó a ser un campo nuevo, simple.
  designDetails String?
  copy          String? // texto simple del posteo — este SÍ viaja al portal del cliente
  hashtags      String?
  internalNotes String? // NUNCA viaja al portal del cliente
  scheduledAt   DateTime? // fecha+hora de publicación planificada (UTC)
  // "YYYY-MM-DD" en Project.timezone, calculado por el backend al escribir. El
  // calendario agrupa por este string para no hacer aritmética de zona horaria en
  // el cliente (mismo criterio que WorkDay.date y ProjectMeeting.date).
  scheduledDate String?
  publishedAt   DateTime?
  publishedUrl  String?
  ownerId       Int? // responsable interno
  owner         User?     @relation("ContentPieceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  order         Int       @default(0) // orden dentro de la columna del Kanban
  // Tarea del dashboard vinculada ("enviar al dashboard"). Completarla avanza la
  // pieza según ADVANCE_ON_TASK_DONE. SetNull: borrar la tarea no borra la pieza.
  taskId        Int?      @unique
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Denormalizados para filtros y badges sin joinear el log. La verdad histórica
  // completa (quién aprobó qué y cuándo) vive en ContentStatusEvent.
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedByContactId Int?
  approvedBy          ClientPortalContact? @relation(fields: [approvedByContactId], references: [id], onDelete: SetNull)
  changesRequestedAt  DateTime?

  createdById Int?
  createdBy   User?    @relation("ContentPieceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets        ContentAsset[]
  comments      ContentComment[]
  statusEvents  ContentStatusEvent[]
  notifications Notification[]

  @@index([workspaceId])
  @@index([projectId, scheduledDate]) // vista Calendario (rango de mes)
  @@index([projectId, status, order]) // vista Kanban
  @@index([projectId, updatedAt]) // tiebreak legacy / futuras vistas por última edición
}

// Asset de una pieza. Ciclo de vida en dos pasos por el flujo de presigned URL:
// 'pending' (URL firmada emitida, bytes todavía no confirmados) → 'ready'.
// Los 'pending' abandonados los barre la limpieza semanal (cleanup.service.js).
model ContentAsset {
  id          Int          @id @default(autoincrement())
  // Id no adivinable para la URL pública: un <img src> no puede llevar
  // Authorization, así que la no-adivinabilidad ES el control de acceso
  // (mismo criterio que SocialImage.id). Con un Int se podría enumerar el
  // contenido sin publicar de todos los clientes.
  publicId    String       @unique @default(uuid())
  workspaceId Int
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pieceId     Int
  piece       ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  kind        String // "image" | "video" | "link"
  status      String       @default("pending") // "pending" | "ready"
  mimeType    String? // null para kind:"link" (no hay archivo propio)
  objectKey   String? // key en R2, bajo el prefijo content/<workspaceId>/
  imageData   Bytes? // fallback sin R2 (solo imagen, dev local) — patrón de SocialImage
  sourceUrl   String? // URL externa para kind:"link" (Google Drive, etc.) — sin subir archivo
  posterKey   String? // thumbnail del video, generado en el browser
  sizeBytes   Int? // autoritativo: sale del HeadObject post-upload, no del cliente
  width       Int?
  height      Int?
  durationSec Int?
  fileName    String? // solo display; NUNCA se usa para armar la key
  order       Int      @default(0)
  uploadedById Int?
  uploadedBy  User?    @relation("ContentAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  confirmedAt DateTime?

  @@index([pieceId, order])
  @@index([workspaceId])
  @@index([status, createdAt]) // barrido de huérfanos 'pending'
}

// Un solo modelo para las dos audiencias, discriminado por `visibility`.
// REGLA DURA: los internos jamás salen del backend hacia el portal — el query
// público filtra por visibility: 'client' en el WHERE de SQL (no en JS), y el
// formatter público es una función separada del interno.
model ContentComment {
  id              Int                  @id @default(autoincrement())
  workspaceId     Int
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pieceId         Int
  piece           ContentPiece         @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  visibility      String // "internal" (solo el equipo) | "client" (hilo con el cliente)
  authorUserId    Int? // lo escribió el equipo
  authorUser      User?                @relation("ContentCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorContactId Int? // lo escribió el cliente
  authorContact   ClientPortalContact? @relation(fields: [authorContactId], references: [id], onDelete: SetNull)
  authorName      String? // snapshot del nombre: sobrevive al borrado del contacto
  body            String
  createdAt       DateTime             @default(now())

  @@index([pieceId, visibility, createdAt])
  @@index([workspaceId])
}

// Log append-only. Fuente de verdad de "quién aprobó qué y cuándo". Una aprobación
// ES un evento de este log (action: 'approved'), no un modelo aparte.
model ContentStatusEvent {
  id             Int                  @id @default(autoincrement())
  workspaceId    Int
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pieceId        Int
  piece          ContentPiece         @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  action         String // created | status_change | submitted | approved | changes_requested | published | task_completed
  fromStatus     String?
  toStatus       String?
  actorUserId    Int?
  actorUser      User?                @relation("ContentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorContactId Int?
  actorContact   ClientPortalContact? @relation(fields: [actorContactId], references: [id], onDelete: SetNull)
  actorName      String? // snapshot: el historial sigue legible si se borra el actor
  comment        String? // motivo del "pedir cambios"
  createdAt      DateTime             @default(now())

  @@index([pieceId, createdAt])
  @@index([workspaceId])
}

// ─── WHATSAPP (VENTAS) ───────────────────────────────────────────────────────
// Integración de WhatsApp Business Platform vía un BSP (hoy: Chakra, ver
// backend/src/lib/whatsappProvider/). Cada workspace conecta su propio número
// (multi-tenant) — no hay concepto de "WhatsApp de Bliss" compartido. El
// adaptador de proveedor abstrae el BSP concreto para no atar el resto del
// código a la API de uno en particular (Fase 0 del plan de WhatsApp).

model WhatsappAccount {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider           String  @default("chakra") // clave del adaptador en lib/whatsappProvider/
  // Clave GLOBAL (no scoped a workspace) para resolver el workspace destino
  // cuando llega un webhook sin ningún contexto de sesión — el payload de
  // Chakra identifica el mensaje por `wabaId`, no por phoneNumberId. Ver
  // whatsapp.webhook.js.
  wabaId             String? @unique
  phoneNumberId      String // id del número en el BSP (Chakra: whatsappPhoneNumberId)
  displayPhoneNumber String? // número en formato legible, informativo
  pluginId           String? // Chakra: identifica la conexión/plugin de este cliente final

  // Credenciales cifradas (AES-256-GCM, lib/encryption.js). Se pegan a mano desde
  // el dashboard del BSP — mismo patrón que el "Token de Business Manager" ya
  // usado para Meta Ads/Instagram/Facebook (connect-token), no un redirect OAuth,
  // porque el embedded signup multi-tenant del BSP elegido no está confirmado.
  accessToken   String?
  webhookSecret String? // valida X-Chakra-Signature-256 en el webhook entrante

  status        String   @default("active") // active | disconnected | error
  connectedById Int?
  connectedBy   User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations WhatsappConversation[]
  templates     WhatsappTemplate[]

  @@unique([workspaceId, phoneNumberId])
  @@index([workspaceId])
}

// Una fila por número de teléfono con el que se habló, no por Lead — un mismo
// teléfono puede no matchear ningún Contact todavía (bucket "sin vincular" en
// el inbox, ver Fase 1 del plan). `contactId` se completa al matchear/convertir.
model WhatsappConversation {
  id          Int             @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   Int
  account     WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  phoneE164   String // siempre normalizado E.164 (ver lib/whatsappProvider, no confiar en Contact.phone libre)
  contactName String? // nombre de perfil de WhatsApp, informativo — no es Contact.name

  contactId Int?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Responsable de esta conversación puntual — reasignable, default implícito
  // (calculado en el frontend/controller, no persistido hasta reasignar) es el
  // ownerId del Lead activo del contacto. Ver Fase 2 del plan de WhatsApp.
  assignedToId Int?
  assignedTo   User? @relation("WhatsappConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime?
  lastInboundAt DateTime? // ancla de la ventana de 24hs para poder mandar texto libre

  // Handoff bot/humano (Fase 4 del plan) — true = el bot responde los mensajes
  // entrantes de esta conversación (si además WhatsappBotConfig.enabled); false
  // = un humano "tomó el control" a mano y el bot deja de responder acá hasta
  // que se le devuelve. Default true: si el workspace prende el bot, las
  // conversaciones existentes quedan bot-handled sin necesitar un backfill.
  botEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    WhatsappMessage[]
  reads       WhatsappConversationRead[]
  escalations WhatsappBotEscalation[]

  @@unique([workspaceId, phoneE164])
  @@index([workspaceId, lastMessageAt])
  @@index([contactId])
}

model WhatsappMessage {
  id             Int                  @id @default(autoincrement())
  workspaceId    Int
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId Int
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction String // "in" | "out"
  content   String? @db.Text // para media, es el caption si vino

  waMessageId String @unique // id del mensaje en el BSP, para deduplicar reintentos del webhook

  // Discriminador explícito en vez de forzar el patrón authorId?/systemType? de
  // ChatMessage: acá "quien escribió" puede ser el lead (ni User ni
  // ClientPortalContact), el equipo, el bot (Fase 4) o el sistema.
  senderType   String // "user" | "contact" | "bot" | "system"
  senderUserId Int?
  senderUser   User?  @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  status    String   @default("sent") // sent | delivered | read | failed
  createdAt DateTime @default(now())

  // true = este mensaje saliente abrió/reabrió la conversación con una
  // plantilla aprobada (reopenConversation manual o el motor de
  // automatización) — es lo único que Meta factura como "conversación
  // iniciada por el negocio". Un reply de texto libre dentro de una ventana
  // ya abierta queda en false. Usado por Fase 6 (analítica y costo/uso) para
  // no confundir volumen de mensajes con volumen facturable.
  viaTemplate Boolean @default(false)

  media WhatsappMedia?

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

// Adjunto multimedia de un mensaje (Fase 3 del plan) — 1:1 con WhatsappMessage,
// WhatsApp permite un solo adjunto por mensaje. URL pública no-adivinable
// (mismo criterio que SocialImage/ContentAsset: un <img>/<audio> src no puede
// llevar Authorization, así que la no-adivinabilidad ES el control de acceso),
// servida por GET /api/public/whatsapp-media/:id — nunca el dominio del bucket
// directo (mismo motivo que SocialImage: poder cambiar de bucket sin romper
// mensajes viejos). Dual storage: objectKey en R2 si está configurado, si no
// mediaData en la DB (mismo patrón que SocialImage/ContentAsset).
model WhatsappMedia {
  id          String          @id @default(uuid())
  workspaceId Int
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId   Int             @unique
  message     WhatsappMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind      String // "image" | "audio" | "video" | "document" | "sticker" — WhatsApp message.type
  mimeType  String
  fileName  String? // solo documentos, informativo — nunca se usa para armar la key
  sizeBytes Int?
  objectKey String? // key en R2, bajo el prefijo whatsapp/<workspaceId>/
  mediaData Bytes? // fallback sin R2 (dev local / legacy)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// Mirror directo de ChatChannelRead: 1 fila por (conversación, usuario), sin
// tracking por mensaje. No-leídos = mensajes con id > lastReadMessageId.
model WhatsappConversationRead {
  id                Int                  @id @default(autoincrement())
  workspaceId       Int
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId    Int
  conversation      WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            Int
  user              User                 @relation(fields: [userId], references: [id])
  lastReadMessageId Int?
  lastReadAt        DateTime             @default(now())

  @@unique([conversationId, userId])
}

// Config del bot de WhatsApp por workspace (Fase 4 del plan) — 1 fila por
// workspace (no por conversación). `enabled` es el interruptor maestro: sin
// esto en true, ninguna conversación recibe respuesta automática aunque
// tenga `WhatsappConversation.botEnabled=true`. `prompt` define la
// personalidad/instrucciones; sin texto se usa un default genérico (ver
// whatsappBot.service.js). v1 sin horario ni condiciones de activación —
// solo on/off + takeover manual por conversación (ver plan, "Fase 4").
model WhatsappBotConfig {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  prompt  String? @db.Text

  // Entrenamiento del bot (mejora de precisión + reglas de seguridad, ver
  // whatsappBot.service.js `generateBotReply`): `blockedWords` son palabras/frases
  // que el bot NUNCA debe usar en su respuesta (verificado después de generar, no
  // solo pedido por prompt); `escalationWords` son palabras/frases del CLIENTE que
  // disparan traspaso automático a un humano sin llamar a la IA. Ambas Json arrays
  // de strings, mismo patrón que Workspace.moduleAccess/disabledFeatureKeys.
  // `handoffMessage` es el aviso neutro que se manda al escalar (por baja confianza
  // del modelo o por escalationWords) — null usa un default embebido en código.
  blockedWords    Json    @default("[]")
  escalationWords Json    @default("[]")
  handoffMessage  String?

  // Ejemplos few-shot curados por el admin — Json array de `{question, answer}`,
  // mismo patrón que blockedWords/escalationWords. Se inyectan en el system
  // prompt (buildExamplesBlock) para guiar el estilo/precisión de las
  // respuestas reales, no como conversación real del historial.
  examples Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos de contexto del bot de WhatsApp (base de conocimiento) — el texto
// extraído se inyecta en el system prompt de cada respuesta del bot (ver
// `knowledgeBlock` en whatsappBot.service.js). Contexto simple (texto completo
// truncado), no RAG con embeddings: alcanza para pocos documentos tipo
// brochure/FAQ/manual de servicios. Se extrae UNA VEZ al subir, no en cada mensaje.
// Dual storage igual patrón que WhatsappMedia/SocialImage: objectKey (R2) o
// fileData (bytes en DB, fallback sin R2 configurado).
model WhatsappBotDocument {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fileName  String
  mimeType  String
  sizeBytes Int
  objectKey String? // R2, si está configurado
  fileData  Bytes? // fallback DB, si no hay R2

  extractedText String? @db.Text // lo que realmente se inyecta en el prompt
  charCount     Int     @default(0)
  // `truncated`: el texto se cortó a lo bruto por el tope de tamaño (fallback,
  // ver `summarized`). `summarized`: en vez de cortar a lo bruto, se usó Claude
  // para resumir preservando lo más útil (servicios, precios, políticas, FAQs)
  // — es el camino normal para un documento largo; `truncated` solo queda en
  // true si además el resumen en sí no pudo generarse y se cayó al corte crudo.
  truncated  Boolean @default(false)
  summarized Boolean @default(false)

  status   String  @default("processing") // processing | ready | error
  errorMsg String?

  uploadedById Int?
  uploadedBy   User? @relation("WhatsappBotDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// Registro de cada vez que el bot pasa una conversación a un humano (baja
// confianza del modelo, palabra de escalationWords del cliente, o blockedWords
// persistentes en la respuesta incluso tras reintentar — ver
// whatsappBot.service.js `generateBotReply`/`maybeRespondWithBot`). Independiente
// de si la conversación tiene un Lead asociado (la notificación in-app sí lo
// requiere, este log no) — fuente de verdad para el panel de calidad: revisar
// casos reales en vez de ajustar el prompt a ciegas.
model WhatsappBotEscalation {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId Int
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  trigger       String // 'confidence' | 'escalation_word' | 'blocked_word'
  reason        String?
  clientMessage String? @db.Text // último mensaje del cliente que originó el escalamiento

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// Cache local de plantillas aprobadas por Meta (Fase 5 del plan) — de solo
// lectura de nuestro lado: se sincronizan desde el catálogo de Chakra
// (GET .../message_templates, scoped por wabaId), nunca se crean ni se
// someten a aprobación desde BlissTracker. Sirven para reabrir una
// conversación fuera de la ventana de 24hs, único caso en el que WhatsApp
// permite mandar algo sin texto libre.
model WhatsappTemplate {
  id          Int             @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   Int
  account     WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  externalId String // id de Meta/Chakra del template — para upsert idempotente al re-sincronizar
  name       String
  language   String // ej. "es_AR" — se manda tal cual a sendTemplateMessage
  category   String // MARKETING | UTILITY | AUTHENTICATION
  status     String // APPROVED | PENDING | REJECTED | ... — solo se ofrecen APPROVED para reabrir

  bodyText      String? @db.Text // texto del componente BODY, con placeholders {{1}} {{2}}…
  variableCount Int     @default(0) // cantidad de {{N}} en bodyText, para armar el form de variables al enviar

  syncedAt DateTime @default(now())

  automationRules WhatsappAutomationRule[]

  @@unique([accountId, externalId])
  @@index([workspaceId])
}

// Motor de reglas de reactivación (extiende la Fase 5 del plan, pedido
// explícito del usuario: "dejar criterios configurados que se envíen las
// plantillas"). Cada regla es independiente y simple (un trigger + un umbral
// de días + filtros opcionales de estado/origen + una plantilla) — no es un
// armador de condiciones AND/OR, varias reglas simples cubren el mismo caso
// (ej. una regla para leads en "contactado" con la plantilla A, otra para
// "propuesta" con la plantilla B). Evaluada por un cron diario
// (whatsappAutomation.service.js, enganchado al mismo horario que
// salesReminders). `triggerType` es un catálogo cerrado en código
// (whatsappAutomationCatalog.js), no un enum de Prisma, mismo criterio que
// ContentPiece.status.
model WhatsappAutomationRule {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name   String
  active Boolean @default(true)

  triggerType  String // 'no_reply_days' | 'action_overdue_days' — ver whatsappAutomationCatalog.js
  triggerDays  Int // umbral en días para que la regla dispare
  statusFilter String? // JSON array de LEAD_STATUSES keys; null/[] = todos los estados activos
  originFilter String? // JSON array de ORIGIN keys; null/[] = todos los orígenes

  templateId Int
  template   WhatsappTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Mapeo de las variables {{1}} {{2}}… del template: texto libre que puede
  // incluir merge tags ({{contact_name}}, {{company_name}}, {{lead_title}},
  // {{owner_name}}) resueltos por lead al momento de enviar — ver
  // whatsappAutomation.service.js resolveVariableMapping().
  variableMapping String? // JSON array de strings, mismo largo que template.variableCount

  cooldownDays Int @default(14) // no re-disparar la misma regla sobre el mismo lead antes de N días

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs WhatsappAutomationLog[]

  @@index([workspaceId, active])
}

// Auditoría + cooldown: 1 fila por intento de disparo (regla, lead), exitoso
// o no. El cron consulta esto para no re-disparar la misma regla sobre el
// mismo lead antes de `rule.cooldownDays`.
model WhatsappAutomationLog {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ruleId      Int
  rule        WhatsappAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  leadId      Int
  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status   String // 'sent' | 'skipped' | 'failed'
  errorMsg String?

  createdAt DateTime @default(now())

  @@index([ruleId, leadId, createdAt])
  @@index([workspaceId, createdAt])
}
