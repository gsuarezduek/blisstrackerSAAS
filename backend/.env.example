DATABASE_URL="postgresql://user:password@localhost:5432/team_tracker"
SERP_API_KEY=""                     # SerpAPI key — https://serpapi.com/manage-api-key
JWT_SECRET="change-this-to-a-long-random-string"
RESEND_API_KEY="re_xxxxxxxxxxxx"
FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development

# MCP (Grok u otro cliente MCP remoto) — ver "MCP (Grok) — integración" en CLAUDE.md.
# Las tools viven en /api/mcp; los tokens de acceso son filas de la tabla McpToken.
# Altas/bajas: self-service desde Preferencias → Agentes IA, o para casos puntuales
# backend/scripts/mcp-create-token.js / mcp-revoke-token.js / mcp-list-tokens.js.
# Las 3 env vars de abajo son LEGACY: solo migran en caliente el token de la v1
# (un solo workspace/usuario fijo) la primera vez que se usa — no hacen falta para altas nuevas.
MCP_TOKEN=""
MCP_WORKSPACE_SLUG=""
MCP_USER_EMAIL=""
