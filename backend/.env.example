DATABASE_URL="postgresql://user:password@localhost:5432/team_tracker"
SERP_API_KEY=""                     # SerpAPI key — https://serpapi.com/manage-api-key
JWT_SECRET="change-this-to-a-long-random-string"
RESEND_API_KEY="re_xxxxxxxxxxxx"
FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development

# MCP (Grok u otro cliente MCP remoto) — ver "MCP (Grok) — integración" en CLAUDE.md.
# Las 3 son requeridas para que /api/mcp funcione; sin MCP_TOKEN, el endpoint devuelve 503.
MCP_TOKEN=""                        # secreto estático que manda el cliente MCP como Bearer. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_WORKSPACE_SLUG=""               # slug del único workspace al que puede conectarse el MCP (v1: un solo workspace)
MCP_USER_EMAIL=""                   # email del WorkspaceMember cuya identidad usan las tools (rol/permisos reales de esa membresía)
